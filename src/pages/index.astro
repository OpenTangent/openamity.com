---
// index.astro - Open Amity Official Landing Page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VolitionCore from '../components/VolitionCore.astro';
import MorphologyGraph from '../components/MorphologyGraph.astro';
import SocialTools from '../components/SocialTools.astro';
import ComputerUse from '../components/ComputerUse.astro';
import Providers from '../components/Providers.astro';
import Features from '../components/Features.astro';
import ArchetypeSelector from '../components/ArchetypeSelector.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Open Amity"
  description="Multi-model orchestration framework for building proactive, stateful multi-agent teams with layered memory, autonomous scheduling, and Theory of Mind."
>
  <Header />
  
  <main class="flex-grow">
    <!-- Hero Section: VolitionCore Visual Anchor & Voice Preview -->
    <VolitionCore />

    <!-- Biological Memory Engine: Interactive Canvas Graph -->
    <MorphologyGraph />

    <!-- Social Tools & Sovereign Agent Identity -->
    <SocialTools />

    <!-- Native Linux Computer-Use: Real Shell & Hardware Agency -->
    <ComputerUse />

    <!-- Top Frontier Model Providers & Benchmark Coverage -->
    <Providers />

    <!-- Sovereign Features Architecture & Gemini TTS Studio -->
    <Features />

    <!-- Archetype Selector: Companion, Innovator, Founder -->
    <ArchetypeSelector />

    <!-- Quickstart Terminal -->
    <Quickstart />
  </main>

  <Footer />
</Layout>
