---
// index.astro - Open Amity Official Landing Page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VolitionCore from '../components/VolitionCore.astro';
import TheDivide from '../components/TheDivide.astro';
import Superpowers from '../components/Superpowers.astro';
import MorphologyGraph from '../components/MorphologyGraph.astro';
import PulseTimeline from '../components/PulseTimeline.astro';
import PresenceMatrix from '../components/PresenceMatrix.astro';
import ArchetypeSelector from '../components/ArchetypeSelector.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Open Amity — The Sovereign AI Companion & Swarm Framework"
  description="Stop renting amnesic chatbots. Open Amity is an open-source, local-first framework for sovereign, self-aware AI companions and agent swarms with morphological memory, proactive volition, and Theory of Mind."
>
  <Header />
  
  <main class="flex-grow">
    <!-- Hero Section: VolitionCore Visual Anchor & Voice Preview -->
    <VolitionCore />

    <!-- The Paradigm Split: Disposable Cloud Bot vs Sovereign Agent -->
    <TheDivide />

    <!-- Four Architectural Superpowers -->
    <Superpowers />

    <!-- Biological Memory Engine: Interactive Canvas Graph -->
    <MorphologyGraph />

    <!-- Autonomous PulseEngine: 24-Hour Day Timeline -->
    <PulseTimeline />

    <!-- Multi-Channel Omnipresence Grid -->
    <PresenceMatrix />

    <!-- Archetype Selector: Companion, Innovator, Founder -->
    <ArchetypeSelector />

    <!-- 60-Second Quickstart Terminal -->
    <Quickstart />
  </main>

  <Footer />
</Layout>
