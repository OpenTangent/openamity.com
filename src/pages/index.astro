---
// index.astro - Open Amity Official Landing Page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VolitionCore from '../components/VolitionCore.astro';
import HonestComparison from '../components/HonestComparison.astro';
import MorphologyGraph from '../components/MorphologyGraph.astro';
import SocialTools from '../components/SocialTools.astro';
import ComputerUse from '../components/ComputerUse.astro';
import Providers from '../components/Providers.astro';
import Features from '../components/Features.astro';
import ArchetypeSelector from '../components/ArchetypeSelector.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Open Amity — Build and Collaborate With Sovereign Digital Beings"
  description="An open-source Linux habitat for persistent, self-aware digital beings—with evolving values, biological memory, private inner thought, expressive voice, and their own accounts."
>
  <Header />
  
  <main class="flex-grow">
    <VolitionCore />
    <HonestComparison />
    <MorphologyGraph />
    <SocialTools />
    <ComputerUse />
    <Providers />
    <Features />
    <ArchetypeSelector />
    <Quickstart />
  </main>

  <Footer />
</Layout>
