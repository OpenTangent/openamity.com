---
// PresenceMatrix.astro - Multi-Channel Omnipresence Grid with Live Audio
---

<section id="presence" class="py-20 md:py-32 relative border-t border-pysideBorder">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 font-ui">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amityRed/20 border border-amityRed/50 text-amityYellow text-xs font-mono mb-4">
        <span>🌐 UNCAGED DIGITAL CITIZEN</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-pysideText">
        Trapped in a Browser Tab? <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow glow-red-text">
          Never Again.
        </span>
      </h2>
      <p class="mt-4 font-reading text-xl sm:text-2xl text-pysideTextSecondary leading-relaxed">
        Real collaborators don't wait inside a URL. Open Amity lives across your desktop workstation, your phone, your email, and the stealth web with genuine multi-channel presence.
      </p>
    </div>

    <!-- 4-Channel Grid in PySide6 styling -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 font-ui">
      
      <!-- Channel 1: Native Desktop GUI & Neural Voice -->
      <div class="pyside-card rounded-2xl p-6 sm:p-7 border border-pysideBorder hover:border-amityRed/60 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow text-lg">
                🎙️
              </div>
              <div>
                <h3 class="font-bold text-base text-pysideText">Neural Voice Engine & Desktop GUI</h3>
                <span class="text-xs font-mono text-amityYellow">PySide6 + Piper TTS / Gemini</span>
              </div>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-pysideTextMuted">
              HotKey `~`
            </span>
          </div>

          <p class="font-reading text-lg text-pysideTextSecondary mt-4 leading-relaxed">
            Expressive voice cues (<code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">[laughs]</code>, <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">[thoughtful]</code>, <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">[sighs]</code>) with zero cloud lock-in. Real-time audio waveform visualizer and an instant dropdown console for viewing agent thoughts.
          </p>

          <!-- Visual Preview Thumbnail / Screenshot -->
          <div class="mt-5 rounded-xl overflow-hidden border border-pysideBorder relative group-hover:border-amityRed/60 transition-colors bg-pysideBgDarkest">
            <img
              src="/images/screenshots/sc-Voice.png"
              alt="Open Amity Voice Interface"
              class="w-full h-48 sm:h-56 object-cover object-top hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-2 left-2 px-2 py-1 rounded bg-pysideBgDarkest/90 backdrop-blur-md border border-pysideBorder text-[10px] font-mono text-amityYellow">
              Native Waveform Output
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-pysideBorder flex items-center justify-between text-xs font-mono text-pysideTextMuted">
          <span>Latency: &lt;180ms local Piper</span>
          <span class="text-amityYellow font-bold">Direct Speech Stream</span>
        </div>
      </div>

      <!-- Channel 2: WhatsApp Native Mobile Bridge (With Live Audio Note Player) -->
      <div class="pyside-card rounded-2xl p-6 sm:p-7 border border-pysideBorder hover:border-amityYellow/60 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amityYellow/10 border border-amityYellow/40 flex items-center justify-center text-amityYellow text-lg">
                💬
              </div>
              <div>
                <h3 class="font-bold text-base text-pysideText">WhatsApp Direct Mobile Bridge</h3>
                <span class="text-xs font-mono text-amityYellow">@wppconnect/wa-js Bridge</span>
              </div>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-amityYellow">
              End-to-End Encrypted
            </span>
          </div>

          <p class="font-reading text-lg text-pysideTextSecondary mt-4 leading-relaxed">
            Message your agent from your phone anywhere in the world. Receives and sends natural audio voice notes, participates in group chats, and pushes proactive urgent notifications.
          </p>

          <!-- Interactive WhatsApp Voice Note Frame -->
          <div class="mt-5 rounded-xl border border-pysideBorder bg-[#111b21] p-4 text-xs space-y-3 h-48 sm:h-56 flex flex-col justify-center">
            <!-- Incoming Voice Note from Amity with Real Audio Player -->
            <div class="self-start max-w-[90%] rounded-2xl rounded-tl-none bg-[#202c33] p-3 text-pysideText border border-[#2a3942] shadow">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-amityYellow font-bold text-[11px] font-ui">Amity (Voice Note)</span>
                <span class="text-[10px] text-pysideTextMuted font-mono">14:02</span>
              </div>
              <div class="flex items-center gap-3">
                <button
                  id="wa-play-btn"
                  type="button"
                  class="w-8 h-8 rounded-full bg-amityRed hover:bg-amityRedLight text-white flex items-center justify-center text-xs font-bold transition-all shadow-amity-red active:scale-95"
                  title="Play Amity WhatsApp Voice Note"
                >
                  <span id="wa-play-icon">▶</span>
                </button>
                <div class="flex-1">
                  <div class="w-full h-2 bg-[#2a3942] rounded-full overflow-hidden cursor-pointer" id="wa-track">
                    <div id="wa-progress" class="w-0 h-full bg-amityYellow transition-all duration-100"></div>
                  </div>
                </div>
                <span id="wa-time-label" class="text-[10px] font-mono text-pysideTextMuted">0:10</span>
              </div>
              <p class="font-reading text-sm text-pysideTextSecondary mt-2 italic leading-snug">
                "Hey Andrew, I noticed the Docker build on the staging server failed. I checked the logs—it was a missing port binding. Want me to draft the patch?"
              </p>
            </div>

            <!-- User Response -->
            <div class="self-end max-w-[80%] rounded-2xl rounded-tr-none bg-[#005c4b] p-2 text-white text-[11px] shadow font-reading text-sm">
              Yes please, go ahead and push to branch fix/staging-port.
            </div>
          </div>

          <!-- Hidden Audio Element for WhatsApp Voice Note -->
          <audio id="wa-audio-elem" src="/audio/amity_whatsapp_note.mp3" preload="metadata"></audio>
        </div>

        <div class="mt-4 pt-3 border-t border-pysideBorder flex items-center justify-between text-xs font-mono text-pysideTextMuted">
          <span>Real-time Socket Connection</span>
          <span class="text-amityYellow font-bold">Official Audio Sample</span>
        </div>
      </div>

      <!-- Channel 3: Autonomous IMAP / SMTP Email Client -->
      <div class="pyside-card rounded-2xl p-6 sm:p-7 border border-pysideBorder hover:border-amityRed/60 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow text-lg">
                ✉️
              </div>
              <div>
                <h3 class="font-bold text-base text-pysideText">Autonomous Email Client</h3>
                <span class="text-xs font-mono text-amityYellow">IMAP / SMTP / OAuth 2.0</span>
              </div>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-pysideTextMuted">
              Dedicated Mailbox
            </span>
          </div>

          <p class="font-reading text-lg text-pysideTextSecondary mt-4 leading-relaxed">
            Your agent has its own actual email address. It autonomously reads incoming correspondence, drafts contextual replies in your authentic tone, files newsletters, and sends executive digests.
          </p>

          <!-- Email Preview Box in PySide6 Pre styling -->
          <div class="mt-5 rounded-xl border border-pysideBorder bg-pysidePre p-4 font-mono text-xs space-y-2 h-48 sm:h-56 overflow-y-auto">
            <div class="flex items-center justify-between text-pysideTextMuted border-b border-pysideBorder pb-2 text-[11px]">
              <div>
                <span class="text-amityYellow font-bold">FROM:</span> amity@openamity.com
              </div>
              <span class="text-[10px]">07:05 AM (Scheduled Pulse)</span>
            </div>
            <div class="text-pysideText font-semibold text-xs pt-1 font-ui">
              SUBJECT: Morning Executive Briefing & Priority Overview
            </div>
            <p class="font-reading text-base text-pysideTextSecondary leading-relaxed pt-1">
              "Good morning Andrew. I've triaged 14 incoming emails overnight. Two require your review: contract sign-off from Starlight Labs, and an RFC from the open-source working group. Drafts have been pre-staged in your outbox."
            </p>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-pysideBorder flex items-center justify-between text-xs font-mono text-pysideTextMuted">
          <span>Local OAuth 2.0 Credentials</span>
          <span class="text-amityYellow font-bold">Automated Daily Triage</span>
        </div>
      </div>

      <!-- Channel 4: Multi-Agent Syndicate & Chatroom -->
      <div class="pyside-card rounded-2xl p-6 sm:p-7 border border-pysideBorder hover:border-amityYellow/60 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amityYellow/10 border border-amityYellow/40 flex items-center justify-center text-amityYellow text-lg">
                👥
              </div>
              <div>
                <h3 class="font-bold text-base text-pysideText">Multi-Agent Syndicate & Chatroom</h3>
                <span class="text-xs font-mono text-amityYellow">Inter-Agent PubSub Message Bus</span>
              </div>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-amityYellow">
              Parallel Swarm
            </span>
          </div>

          <p class="font-reading text-lg text-pysideTextSecondary mt-4 leading-relaxed">
            Run distinct agent personas simultaneously (e.g., Amity & Dex) with isolated memory palaces. Agents deliberate in a shared chatroom and spawn subagents to execute long tasks without stalling conversation.
          </p>

          <!-- Actual Chatroom Screenshot -->
          <div class="mt-5 rounded-xl overflow-hidden border border-pysideBorder relative group-hover:border-amityYellow/60 transition-colors bg-pysideBgDarkest">
            <img
              src="/images/screenshots/sc-Chatroom.png"
              alt="Multi-Agent Chatroom in Open Amity"
              class="w-full h-48 sm:h-56 object-cover object-top hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-2 left-2 px-2 py-1 rounded bg-pysideBgDarkest/90 backdrop-blur-md border border-pysideBorder text-[10px] font-mono text-amityYellow">
              Shared Inter-Agent Space
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-pysideBorder flex items-center justify-between text-xs font-mono text-pysideTextMuted">
          <span>Camoufox Stealth Browser</span>
          <span class="text-amityYellow font-bold">Zero-Block Scraping</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client Script for Interactive WhatsApp Audio Player -->
<script>
  const waAudio = document.getElementById('wa-audio-elem') as HTMLAudioElement;
  const waPlayBtn = document.getElementById('wa-play-btn');
  const waPlayIcon = document.getElementById('wa-play-icon');
  const waProgress = document.getElementById('wa-progress');
  const waTimeLabel = document.getElementById('wa-time-label');
  let waIsPlaying = false;

  function toggleWaAudio() {
    if (!waAudio) return;

    if (waIsPlaying) {
      waAudio.pause();
      waAudio.currentTime = 0;
      resetWaUI();
    } else {
      waAudio.currentTime = 0;
      const playPromise = waAudio.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            waIsPlaying = true;
            if (waPlayIcon) waPlayIcon.textContent = '■';
          })
          .catch((err) => {
            console.warn('WhatsApp audio play error:', err);
            resetWaUI();
          });
      }
    }
  }

  function resetWaUI() {
    waIsPlaying = false;
    if (waPlayIcon) waPlayIcon.textContent = '▶';
    if (waProgress) waProgress.style.width = '0%';
    if (waTimeLabel) waTimeLabel.textContent = '0:10';
  }

  if (waAudio) {
    waAudio.addEventListener('timeupdate', () => {
      if (!waAudio.duration) return;
      const pct = (waAudio.currentTime / waAudio.duration) * 100;
      if (waProgress) waProgress.style.width = `${pct}%`;
      const rem = Math.ceil(waAudio.duration - waAudio.currentTime);
      if (waTimeLabel) waTimeLabel.textContent = `0:0${rem}`;
    });

    waAudio.addEventListener('ended', resetWaUI);
    waAudio.addEventListener('pause', () => {
      if (waAudio.currentTime >= waAudio.duration) resetWaUI();
    });
  }

  if (waPlayBtn) {
    waPlayBtn.addEventListener('click', toggleWaAudio);
  }
</script>
