---
// Header.astro - Open Amity Header with PySide6 Dark Greys & Red/Yellow Accents
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-pysideBg/90 border-b border-pysideBorder transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-xl overflow-hidden border border-amityRed/60 bg-pysideCard flex items-center justify-center shadow-amity-red group-hover:scale-105 transition-transform duration-300">
        <img src="/images/com.openamity.OpenAmity.png" alt="Open Amity Glyph" class="w-8 h-8 sm:w-9 sm:h-9 object-contain" />
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-bold tracking-tight text-pysideText group-hover:text-amityYellow transition-colors flex items-center gap-2 font-ui">
          OPEN AMITY
          <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded-full bg-amityRed/20 text-amityYellow border border-amityRed/50 hidden sm:inline-block">
            GPLv3 Sovereign
          </span>
        </span>
        <span class="text-[11px] font-mono text-pysideTextMuted tracking-wider hidden sm:block">
          Local-First Agent Framework
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-pysideTextSecondary font-ui">
      <a href="#divide" class="hover:text-amityYellow transition-colors">The Paradigm</a>
      <a href="#superpowers" class="hover:text-amityYellow transition-colors">Superpowers</a>
      <a href="#morphology" class="hover:text-amityYellow transition-colors">Morphological Memory</a>
      <a href="#pulses" class="hover:text-amityYellow transition-colors">Pulse Engine</a>
      <a href="#presence" class="hover:text-amityYellow transition-colors">Omnichannel</a>
      <a href="#archetypes" class="hover:text-amityYellow transition-colors">Who It's For</a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <!-- GitHub Button -->
      <a
        href="https://github.com/OpenTangent/OpenAmity"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-mono font-medium rounded-lg bg-pysideCard hover:bg-pysideCardHover border border-pysideBorder hover:border-amityYellow/50 text-pysideText transition-all group"
      >
        <svg class="w-4 h-4 text-pysideTextMuted group-hover:text-pysideText" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span class="hidden sm:inline">Star on</span> GitHub
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-amityYellow/10 text-amityYellow border border-amityYellow/30">
          ★
        </span>
      </a>

      <!-- Quickstart CTA -->
      <a
        href="#quickstart"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold font-ui rounded-lg bg-amityRed text-white hover:bg-amityRedLight shadow-amity-red hover:shadow-amity-red-lg border border-amityRedLight/40 transition-all duration-300 transform active:scale-95"
      >
        <span>⚡ Quickstart</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-pysideTextMuted hover:text-pysideText hover:bg-pysideCard border border-transparent hover:border-pysideBorder"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-pysideBorder bg-pysideBg/95 backdrop-blur-xl px-4 pt-2 pb-6 space-y-3 font-medium text-sm font-ui">
    <a href="#divide" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">The Paradigm</a>
    <a href="#superpowers" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">Superpowers</a>
    <a href="#morphology" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">Morphological Memory</a>
    <a href="#pulses" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">Pulse Engine</a>
    <a href="#presence" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">Omnichannel</a>
    <a href="#archetypes" class="block py-2 text-pysideTextSecondary hover:text-amityYellow border-b border-pysideBorder/40">Who It's For</a>
    <a href="#quickstart" class="block py-2 text-amityYellow font-semibold">⚡ Quickstart Guide</a>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
