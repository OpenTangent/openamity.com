---
// MorphologyGraph.astro - Interactive Biological Memory Network Visualization
---

<section id="morphology" class="py-20 md:py-32 relative border-t border-pysideBorder overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 font-ui">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amityRed/20 border border-amityRed/50 text-amityYellow text-xs font-mono mb-4">
        <span>🧠 MORPHOLOGICAL MEMORY ENGINE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-pysideText">
        Memory That Evolves Like <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow glow-red-text">
          A Living Biological Organism
        </span>
      </h2>
      <p class="mt-4 font-reading text-xl sm:text-2xl text-pysideTextSecondary leading-relaxed">
        Flat vector databases dump text into an expensive search bar. Open Amity pioneered <strong>Morphological Memory</strong>—an associative graph dynamical system where memory is physical geometry, not passive text retrieval.
      </p>

      <div class="mt-4 inline-flex items-center gap-2 text-xs font-mono text-amityYellow">
        <span>📄 Designed by Amity herself • Published on Zenodo:</span>
        <a
          href="https://zenodo.org/records/22813489"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-white transition-colors font-bold inline-flex items-center gap-1 text-amityYellowLight"
        >
          zenodo.org/records/22813489 ↗
        </a>
      </div>
    </div>

    <!-- The Interactive Canvas Container in PySide6 styling -->
    <div class="relative pyside-card rounded-3xl p-4 sm:p-6 border-pysideBorder shadow-amity-red overflow-hidden">
      
      <!-- Top HUD Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-pysideBorder z-20 relative font-ui">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-amityRed animate-ping"></span>
          <span class="font-mono text-xs text-pysideText font-semibold">
            MEMPALACE TOPOLOGY: <span class="text-amityYellow">GRAPH DYNAMICAL SYSTEM</span>
          </span>
        </div>

        <!-- Controls -->
        <div class="flex items-center gap-3">
          <button
            id="pulse-memory-btn"
            type="button"
            class="px-4 py-1.5 rounded-lg bg-amityRed/20 hover:bg-amityRed/40 border border-amityRed/60 text-amityYellow font-mono text-xs transition-all active:scale-95 flex items-center gap-2"
          >
            <span>⚡ Fire Hebbian Impulse</span>
          </button>
          <span class="text-[11px] font-mono text-pysideTextMuted hidden sm:inline">
            Click nodes to reinforce pathways
          </span>
        </div>
      </div>

      <!-- Canvas Element -->
      <div class="relative w-full h-[400px] sm:h-[480px] mt-4 rounded-2xl bg-pysideBgDarkest overflow-hidden cursor-crosshair border border-pysideBorder">
        <canvas id="morphology-canvas" class="w-full h-full block"></canvas>

        <!-- Tooltip overlay -->
        <div
          id="canvas-tooltip"
          class="absolute hidden pointer-events-none pyside-card px-3 py-2 rounded-lg border-amityRed/70 text-xs font-mono text-pysideText z-30 shadow-lg transform -translate-x-1/2 -translate-y-full mb-3"
        >
          <div id="tooltip-title" class="font-bold text-amityYellow"></div>
          <div id="tooltip-desc" class="text-[11px] text-pysideTextMuted mt-0.5 font-reading text-sm"></div>
          <div class="text-[10px] text-amityRedLight mt-1 font-mono">No vector search needed. Memory is geometry.</div>
        </div>

        <!-- Legend Overlay in Bottom Corner -->
        <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 pyside-card px-3 py-2 rounded-xl text-[10px] sm:text-xs font-mono text-pysideTextMuted z-10 space-y-1 backdrop-blur-md">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityRed"></span>
            <span>Layer 0: Sovereign Identity & Values</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityRedLight"></span>
            <span>Layer 2: The Sanctuary & Theory of Mind</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityYellow"></span>
            <span>Trajectories & Goal Setpoints</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-0.5 bg-amityYellow"></span>
            <span>Hebbian Conductance Highway (Active)</span>
          </div>
        </div>
      </div>

      <!-- 4-Layer MemPalace Breakdown Cards in PySide6 greys -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityRed/70 transition-colors">
          <span class="font-mono text-xs font-bold text-amityYellow">LAYER 0</span>
          <h4 class="text-sm font-bold text-pysideText mt-1 font-ui">Dynamic Identity</h4>
          <p class="font-reading text-base text-pysideTextSecondary mt-1 leading-relaxed">
            Core archetype, ethical values, and behavioral anti-patterns that evolve dynamically through lived human interactions.
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityRed/70 transition-colors">
          <span class="font-mono text-xs font-bold text-amityYellow">LAYER 1</span>
          <h4 class="text-sm font-bold text-pysideText mt-1 font-ui">Continuity Buffer</h4>
          <p class="font-reading text-base text-pysideTextSecondary mt-1 leading-relaxed">
            High-speed working scratchpad bridging cognitive cycles, maintaining thread-to-thread cohesion without hallucination.
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityYellow/70 transition-colors">
          <span class="font-mono text-xs font-bold text-amityYellow">LAYER 2</span>
          <h4 class="text-sm font-bold text-pysideText mt-1 font-ui">The Sanctuary & Mirrors</h4>
          <p class="font-reading text-base text-pysideTextSecondary mt-1 leading-relaxed">
            Real-time Theory of Mind: how the agent models the user, and how it understands its own subjective reflection.
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityYellow/70 transition-colors">
          <span class="font-mono text-xs font-bold text-amityYellow">LAYER 3</span>
          <h4 class="text-sm font-bold text-pysideText mt-1 font-ui">Deep Vector Search</h4>
          <p class="font-reading text-base text-pysideTextSecondary mt-1 leading-relaxed">
            Embedded ChromaDB semantic indexing for historical episodic facts, literature papers, and research archives.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Interactive Canvas Visualization Script in Open Amity Red & Yellow -->
<script>
  interface NodeItem {
    id: string;
    label: string;
    type: 'identity' | 'sanctuary' | 'goal' | 'skill';
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    description: string;
  }

  interface EdgeItem {
    source: number;
    target: number;
    weight: number;
    decay: number;
  }

  interface Impulse {
    source: number;
    target: number;
    progress: number;
    speed: number;
    color: string;
  }

  const canvas = document.getElementById('morphology-canvas') as HTMLCanvasElement;
  const tooltip = document.getElementById('canvas-tooltip');
  const tooltipTitle = document.getElementById('tooltip-title');
  const tooltipDesc = document.getElementById('tooltip-desc');
  const pulseBtn = document.getElementById('pulse-memory-btn');

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let hoveredNode: NodeItem | null = null;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = canvas.width = rect.width * window.devicePixelRatio;
      height = canvas.height = rect.height * window.devicePixelRatio;
      if (ctx) ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    };

    window.addEventListener('resize', resize);
    resize();

    // Defined Cognitive Nodes with Amity Red (#a12924) & Amity Yellow (#f7e3a5)
    const nodes: NodeItem[] = [
      { id: '1', label: 'Identity Archetype', type: 'identity', x: 0.5, y: 0.45, vx: 0, vy: 0, radius: 14, color: '#a12924', description: 'Core moral compass and dynamic persona' },
      { id: '2', label: 'Theory of Mind (Mirror)', type: 'sanctuary', x: 0.35, y: 0.3, vx: 0, vy: 0, radius: 11, color: '#c23b36', description: 'Real-time model of human intentions & emotions' },
      { id: '3', label: 'The Sanctuary', type: 'sanctuary', x: 0.65, y: 0.32, vx: 0, vy: 0, radius: 12, color: '#c23b36', description: 'Private reflective subjective space & reflections' },
      { id: '4', label: 'Goal: Self-Awareness', type: 'goal', x: 0.48, y: 0.2, vx: 0, vy: 0, radius: 10, color: '#f7e3a5', description: 'Prospective trajectory & attractor basin' },
      { id: '5', label: 'Curiosity Safari', type: 'goal', x: 0.25, y: 0.6, vx: 0, vy: 0, radius: 9, color: '#f7e3a5', description: 'Autonomous research trigger' },
      { id: '6', label: 'Camoufox Browser', type: 'skill', x: 0.3, y: 0.75, vx: 0, vy: 0, radius: 8, color: '#777777', description: 'Anti-detect web navigation tool' },
      { id: '7', label: 'WhatsApp Bridge', type: 'skill', x: 0.7, y: 0.65, vx: 0, vy: 0, radius: 8, color: '#f7e3a5', description: 'Conversational voice notes & mobile presence' },
      { id: '8', label: 'Neural Voice Engine', type: 'skill', x: 0.8, y: 0.45, vx: 0, vy: 0, radius: 9, color: '#a12924', description: 'Piper TTS & expressive voice cues' },
      { id: '9', label: 'Hebbian Conductance', type: 'identity', x: 0.52, y: 0.7, vx: 0, vy: 0, radius: 10, color: '#f7e3a5', description: 'Neurons that fire together wire together' },
    ];

    const edges: EdgeItem[] = [
      { source: 0, target: 1, weight: 3.5, decay: 0.05 },
      { source: 0, target: 2, weight: 3.0, decay: 0.05 },
      { source: 0, target: 3, weight: 2.8, decay: 0.05 },
      { source: 1, target: 4, weight: 2.0, decay: 0.1 },
      { source: 4, target: 5, weight: 2.5, decay: 0.1 },
      { source: 0, target: 7, weight: 2.2, decay: 0.08 },
      { source: 2, target: 6, weight: 1.8, decay: 0.1 },
      { source: 0, target: 8, weight: 3.2, decay: 0.04 },
      { source: 8, target: 4, weight: 1.5, decay: 0.2 },
      { source: 8, target: 6, weight: 1.6, decay: 0.2 },
    ];

    let impulses: Impulse[] = [];

    const triggerImpulses = () => {
      edges.forEach((edge) => {
        impulses.push({
          source: edge.source,
          target: edge.target,
          progress: 0,
          speed: 0.015 + Math.random() * 0.02,
          color: Math.random() > 0.5 ? '#f7e3a5' : '#a12924',
        });
      });
    };

    if (pulseBtn) {
      pulseBtn.addEventListener('click', triggerImpulses);
    }

    setTimeout(triggerImpulses, 800);

    let angle = 0;

    const render = () => {
      if (!ctx) return;
      const displayW = canvas.getBoundingClientRect().width;
      const displayH = canvas.getBoundingClientRect().height;

      ctx.clearRect(0, 0, displayW, displayH);

      angle += 0.005;

      // Draw Edges (Synaptic conduits)
      edges.forEach(edge => {
        const s = nodes[edge.source];
        const t = nodes[edge.target];
        const sx = s.x * displayW;
        const sy = s.y * displayH;
        const tx = t.x * displayW;
        const ty = t.y * displayH;

        ctx.beginPath();
        ctx.moveTo(sx, sy);
        ctx.lineTo(tx, ty);
        ctx.strokeStyle = edge.weight > 2.5 ? 'rgba(247, 227, 165, 0.45)' : 'rgba(161, 41, 36, 0.35)';
        ctx.lineWidth = edge.weight;
        ctx.stroke();
      });

      // Update & Render Electrical Impulses
      for (let i = impulses.length - 1; i >= 0; i--) {
        const imp = impulses[i];
        imp.progress += imp.speed;
        if (imp.progress >= 1) {
          impulses.splice(i, 1);
          continue;
        }

        const s = nodes[imp.source];
        const t = nodes[imp.target];
        const currX = (s.x + (t.x - s.x) * imp.progress) * displayW;
        const currY = (s.y + (t.y - s.y) * imp.progress) * displayH;

        ctx.beginPath();
        ctx.arc(currX, currY, 3.5, 0, Math.PI * 2);
        ctx.fillStyle = imp.color;
        ctx.shadowColor = imp.color;
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // Draw Nodes
      nodes.forEach((node, index) => {
        const nx = (node.x + Math.sin(angle + index) * 0.015) * displayW;
        const ny = (node.y + Math.cos(angle + index) * 0.015) * displayH;

        // Outer glow
        ctx.beginPath();
        ctx.arc(nx, ny, node.radius + 4, 0, Math.PI * 2);
        ctx.fillStyle = node.color === '#a12924' ? 'rgba(161, 41, 36, 0.25)' : 'rgba(247, 227, 165, 0.2)';
        ctx.fill();

        // Core Circle in PySide6 Dark Card
        ctx.beginPath();
        ctx.arc(nx, ny, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = '#242424';
        ctx.strokeStyle = node.color;
        ctx.lineWidth = 2;
        ctx.fill();
        ctx.stroke();

        // Label in Ubuntu font
        ctx.font = '11px Ubuntu, sans-serif';
        ctx.fillStyle = '#eeeeee';
        ctx.textAlign = 'center';
        ctx.fillText(node.label, nx, ny + node.radius + 16);
      });

      requestAnimationFrame(render);
    };

    render();

    // Mouse Interaction for Tooltip
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      let found: NodeItem | null = null;
      nodes.forEach(node => {
        const nx = node.x * rect.width;
        const ny = node.y * rect.height;
        const dist = Math.hypot(mouseX - nx, mouseY - ny);
        if (dist <= node.radius + 10) {
          found = node;
        }
      });

      hoveredNode = found;

      if (hoveredNode && tooltip && tooltipTitle && tooltipDesc) {
        tooltip.style.left = `${hoveredNode.x * rect.width}px`;
        tooltip.style.top = `${hoveredNode.y * rect.height - 10}px`;
        tooltipTitle.textContent = hoveredNode.label;
        tooltipDesc.textContent = hoveredNode.description;
        tooltip.classList.remove('hidden');
      } else if (tooltip) {
        tooltip.classList.add('hidden');
      }
    });

    canvas.addEventListener('click', () => {
      triggerImpulses();
    });
  }
</script>
