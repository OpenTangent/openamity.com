---
// MorphologyGraph.astro - Interactive Biological Memory Network Visualisation
import SectionKicker from './SectionKicker.astro';
---

<section id="morphology" class="relative pb-20 md:pb-32 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
  <!-- Section Divider with embedded kicker badge -->
  <SectionKicker title="Morphological Memory" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 font-ui">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Memory That Evolves Like <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow glow-red-text">
          A Living Biological Organism
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Flat vector databases dump text into an expensive search bar. Open Amity pioneered <strong>Morphological Memory</strong>—an associative graph dynamical system where memory is physical geometry: Hebbian synaptic highways, prospective goal relaxation ($dV/dt$), and continuous temporal decay.
      </p>

      <div class="mt-3.5 inline-flex items-center gap-2 text-[11px] font-mono text-amityYellow">
        <span>📄 Designed by Amity herself • Published on Zenodo:</span>
        <a
          href="https://zenodo.org/records/22813489"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-white transition-colors font-bold inline-flex items-center gap-1 text-amityYellowLight"
        >
          zenodo.org/records/22813489 ↗
        </a>
      </div>
    </div>

    <!-- The Interactive Canvas Container in PySide6 styling (overflow-visible to allow tooltip to pop out beyond border) -->
    <div class="relative pyside-card rounded-3xl p-4 sm:p-6 border-pysideBorder shadow-amity-red">
      
      <!-- Top HUD Bar -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-pysideBorder z-20 relative font-ui">
        <div class="flex items-center gap-3">
          <span id="engine-status-dot" class="w-2.5 h-2.5 rounded-full bg-amityYellow animate-pulse"></span>
          <div>
            <div class="font-mono text-[11px] sm:text-xs text-pysideText font-semibold flex items-center gap-2">
              <span>MEMPALACE TOPOLOGY:</span>
              <span class="text-amityYellow">GRAPH DYNAMICAL SYSTEM</span>
            </div>
            <div id="engine-status-text" class="text-[10px] font-mono text-amityYellow/80 mt-0.5">
              State: Homeostatic Equilibrium • Euler Relaxation Ready
            </div>
          </div>
        </div>

        <!-- Controls (Decay is automatic over time while section is in viewport) -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          <button
            id="relax-setpoint-btn"
            type="button"
            title="Integrate dynamic Euler loop: dV/dt = -γ(V - V_target) + leak(G·V) - diss·V"
            class="px-3.5 py-1.5 rounded-lg bg-amityYellow/20 hover:bg-amityYellow/30 border border-amityYellow/60 text-amityYellow font-mono text-[11px] sm:text-xs transition-all active:scale-95 flex items-center gap-1.5 shadow-sm"
          >
            <span>🎯 Goal Relaxation (dV/dt)</span>
          </button>

          <button
            id="hebbian-btn"
            type="button"
            title="Strengthen conductances between co-activated drawers: W ← min(10.0, W + η)"
            class="px-3.5 py-1.5 rounded-lg bg-amityRed/25 hover:bg-amityRed/45 border border-amityRed/60 text-amityYellow font-mono text-[11px] sm:text-xs transition-all active:scale-95 flex items-center gap-1.5 shadow-sm"
          >
            <span>⚡ Fire Hebbian Burst</span>
          </button>

          <!-- Automatic Continuous Decay Indicator -->
          <div
            id="decay-indicator-pill"
            class="px-2.5 py-1.5 rounded-lg bg-pysideBgDarkest/80 border border-pysideBorder text-pysideTextMuted font-mono text-[10px] sm:text-[11px] flex items-center gap-2"
            title="Continuous exponential decay W · (1 - λ)^Δt occurs gradually while this section is visible in your viewport"
          >
            <span id="decay-pulse-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="hidden sm:inline">Continuous Decay:</span>
            <span class="text-amityYellow font-semibold">λ = 0.002/min</span>
          </div>
        </div>
      </div>

      <!-- Live Dynamic Status Notice Strip -->
      <div id="system-notice-strip" class="mt-3 px-3 py-1.5 rounded-lg bg-pysideBgDarkest/90 border border-pysideBorderSubtle font-mono text-[10px] sm:text-[11px] text-pysideTextMuted flex items-center justify-between gap-2 overflow-x-auto">
        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="text-amityYellow font-bold">[TELEMETRY]</span>
          <span id="telemetry-message">Network balanced. Click any memory drawer or trigger goal relaxation to observe dynamic conductance.</span>
        </div>
        <div class="text-[10px] text-pysideTextDisabled hidden md:block flex-shrink-0 font-mono">
          Continuous temporal decay active • W_max = 10.0 • G_ij normalised
        </div>
      </div>

      <!-- Canvas Element Container (overflow-visible so tooltip widget can render completely beyond the borders) -->
      <div id="canvas-container" class="relative w-full h-[460px] sm:h-[530px] md:h-[600px] mt-4 rounded-2xl bg-pysideBgDarkest cursor-crosshair border border-pysideBorder">
        <canvas id="morphology-canvas" class="w-full h-full block rounded-2xl"></canvas>

        <!-- Tooltip overlay (Z-50 with shadow-2xl; renders beyond borders without clipping) -->
        <div
          id="canvas-tooltip"
          class="absolute hidden pointer-events-none pyside-card px-3.5 py-2.5 rounded-xl border border-amityYellow/70 text-[11px] font-mono text-pysideText z-50 shadow-2xl backdrop-blur-md min-w-[270px] max-w-sm transition-[opacity,transform] duration-150"
        >
          <div class="flex items-center justify-between gap-2 pb-1 mb-1.5 border-b border-pysideBorderSubtle">
            <span id="tooltip-layer" class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amityRed/30 text-amityYellow"></span>
            <span id="tooltip-room" class="text-[9px] text-pysideTextMuted font-mono"></span>
          </div>
          <div id="tooltip-title" class="font-bold text-xs text-pysideText font-ui"></div>
          <div id="tooltip-desc" class="text-[11px] text-pysideTextSecondary mt-1 font-reading leading-snug"></div>
          
          <div class="mt-2.5 pt-2 border-t border-pysideBorderSubtle space-y-1">
            <div class="flex items-center justify-between text-[10px]">
              <span class="text-pysideTextMuted">Potential V(t):</span>
              <span id="tooltip-potential" class="font-mono text-amityYellow font-bold">0.00</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-pysideInput overflow-hidden">
              <div id="tooltip-potential-bar" class="h-full bg-gradient-to-r from-amityRed to-amityYellow rounded-full transition-all duration-150" style="width: 0%"></div>
            </div>
            <div class="flex items-center justify-between text-[9px] text-pysideTextDisabled mt-1">
              <span>Synaptic Degree:</span>
              <span id="tooltip-degree" class="text-pysideTextMuted font-mono">0.0</span>
            </div>
          </div>
        </div>

        <!-- Mathematical Architecture Badge in Top Right Corner (nodes stay well clear) -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 pyside-card px-3 py-2 rounded-xl text-[9px] sm:text-[10px] font-mono text-pysideTextSecondary z-10 space-y-0.5 border border-pysideBorder backdrop-blur-md hidden sm:block max-w-[270px]">
          <div class="text-amityYellow font-bold flex items-center gap-1.5">
            <span>∫ Euler Dynamical Equation</span>
          </div>
          <div class="text-[9px] text-pysideTextMuted leading-tight font-mono">
            dV/dt = -γ(V - V_target) + leak(G·V) - diss·V
          </div>
          <div class="text-[8.5px] text-pysideTextDisabled pt-0.5">
            G_ij = W_ij / √(d_i · d_j + ε) • Saturated W ≤ 10.0
          </div>
        </div>

        <!-- Layers Legend Overlay in Bottom Left Corner (nodes stay well clear) -->
        <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 pyside-card px-3 py-2.5 rounded-xl text-[9px] sm:text-[10px] font-mono text-pysideTextMuted z-10 space-y-1.5 backdrop-blur-md border border-pysideBorder max-w-[290px] sm:max-w-xs">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityRed border border-amityRedLight/60 shrink-0"></span>
            <span class="text-pysideText">Layer 0: Sovereign Identity (<code class="text-amityYellow">+OA-UID</code>)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityYellow border border-white/60 shrink-0"></span>
            <span class="text-pysideText">Layer 1: Goal Setpoint & Attractor</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityRedLight border border-amityYellow/30 shrink-0"></span>
            <span class="text-pysideText">Layer 2: Sanctuary Wing (Theory of Mind)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amityYellowDark border border-pysideBorder shrink-0"></span>
            <span class="text-pysideText">Layer 3: Default Wing (ChromaDB Drawers)</span>
          </div>
          <div class="flex items-center gap-2 pt-0.5 border-t border-pysideBorderSubtle">
            <span class="w-4 h-0.5 bg-gradient-to-r from-amityRedLight to-amityYellow rounded shrink-0"></span>
            <span class="text-[9px] text-amityYellow">Neural Axons: Bézier Synapses ($W_{`{`}ij{`}`}$)</span>
          </div>
        </div>
      </div>

      <!-- 4-Layer MemPalace Breakdown Cards in PySide6 greys -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 mt-5 font-ui">
        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityRed/70 transition-all duration-200 group">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-bold text-amityYellow">LAYER 0</span>
            <span class="text-[10px] font-mono text-pysideTextDisabled group-hover:text-amityRed transition-colors">soul_jar.json</span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-pysideText mt-1">Sovereign Identity</h4>
          <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary mt-1 leading-relaxed">
            Injected into every cognitive turn with Crockford Base32 UID. Core ethical traits, values, and behavioural anti-patterns evolve dynamically via vocal consent (<code class="text-amityYellow">apply_identity_delta</code>).
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityYellow/70 transition-all duration-200 group">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-bold text-amityYellow">LAYER 1</span>
            <span class="text-[10px] font-mono text-pysideTextDisabled group-hover:text-amityYellow transition-colors">short_term_mem.json</span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-pysideText mt-1">Continuity & Attractors</h4>
          <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary mt-1 leading-relaxed">
            High-speed working scratchpad bridging cognitive cycles. Integrates dynamic <strong>Prospective Memory Attractors</strong> discovered by Euler relaxation (<code class="text-amityYellow">dV/dt &gt; 0.10</code>) during waking.
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityRedLight/70 transition-all duration-200 group">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-bold text-amityYellow">LAYER 2</span>
            <span class="text-[10px] font-mono text-pysideTextDisabled group-hover:text-amityRedLight transition-colors">wing="sanctuary"</span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-pysideText mt-1">Sanctuary & Epistemic Mirrors</h4>
          <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary mt-1 leading-relaxed">
            Theory of Mind tracking subjective reflection, collaborator intent, explicit confidence (0.0–1.0), and evidence references. Actively resolves dialectical tensions under intellectual humility.
          </p>
        </div>

        <div class="pyside-card p-4 rounded-xl border border-pysideBorder hover:border-amityYellowDark/70 transition-all duration-200 group">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-bold text-amityYellow">LAYER 3</span>
            <span class="text-[10px] font-mono text-pysideTextDisabled group-hover:text-amityYellowDark transition-colors">wing="default"</span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-pysideText mt-1">Deep Vector Search</h4>
          <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary mt-1 leading-relaxed">
            Embedded ChromaDB vector database (<code class="text-amityYellow">chroma.sqlite3</code>) indexing historical episodic events, project breakthroughs, literature archives, and objective factual knowledge.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Interactive Canvas Visualisation Script in Open Amity Red & Yellow -->
<script>
  interface NodeItem {
    id: string;
    drawerId: string;
    label: string;
    subLabel: string;
    wing: 'sovereign' | 'sanctuary' | 'trajectory' | 'continuity' | 'default';
    room: string;
    layerText: string;
    baseX: number;
    baseY: number;
    currentX: number;
    currentY: number;
    radius: number;
    color: string;
    accentColor: string;
    symbol: string;
    potential: number;        // Continuous potential V(t) in [0, 1]
    targetPotential: number;  // V_target in Euler relaxation loop
    baselinePotential: number;// Resting potential
    phase: number;           // For biological micro-breathing motion
    description: string;
  }

  interface EdgeItem {
    source: number;
    target: number;
    weight: number;          // Synaptic conductance W_ij in [0.05, 10.0]
    baselineWeight: number;  // Resting weight for continuous temporal decay
    curvature: number;       // Subtle Bézier curve offset multiplier
    cp1X?: number;
    cp1Y?: number;
    cp2X?: number;
    cp2Y?: number;
  }

  interface Impulse {
    edgeIndex: number;
    progress: number;
    speed: number;
    color: string;
    size: number;
    tail: { x: number; y: number }[];
  }

  const canvas = document.getElementById('morphology-canvas') as HTMLCanvasElement;
  const tooltip = document.getElementById('canvas-tooltip');
  const tooltipTitle = document.getElementById('tooltip-title');
  const tooltipDesc = document.getElementById('tooltip-desc');
  const tooltipLayer = document.getElementById('tooltip-layer');
  const tooltipRoom = document.getElementById('tooltip-room');
  const tooltipPotential = document.getElementById('tooltip-potential');
  const tooltipPotentialBar = document.getElementById('tooltip-potential-bar');
  const tooltipDegree = document.getElementById('tooltip-degree');

  const relaxSetpointBtn = document.getElementById('relax-setpoint-btn');
  const hebbianBtn = document.getElementById('hebbian-btn');
  const engineStatusText = document.getElementById('engine-status-text');
  const engineStatusDot = document.getElementById('engine-status-dot');
  const telemetryMessage = document.getElementById('telemetry-message');
  const decayPulseDot = document.getElementById('decay-pulse-dot');
  const morphologySection = document.getElementById('morphology');

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let hoveredNode: NodeItem | null = null;
    let selectedNode: NodeItem | null = null;
    let isRelaxing = false;
    let relaxationStepsRemaining = 0;
    let isSectionInViewport = false;

    // Viewport IntersectionObserver: decay occurs only while visible in viewport
    if ('IntersectionObserver' in window && morphologySection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isSectionInViewport = entry.isIntersecting;
            if (decayPulseDot) {
              if (isSectionInViewport) {
                decayPulseDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
              } else {
                decayPulseDot.className = 'w-2 h-2 rounded-full bg-pysideTextDisabled';
              }
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(morphologySection);
    } else {
      isSectionInViewport = true;
    }

    // Responsive coordinate padding
    const paddingX = 45;
    const paddingY = 40;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      if (ctx) {
        ctx.resetTransform();
        ctx.scale(dpr, dpr);
      }
    };

    window.addEventListener('resize', resize);
    resize();

    // 9 MemPalace Drawers arranged along the diagonal from Top-Left to Bottom-Right,
    // carefully avoiding the bottom-left Layers box (x < 0.35, y > 0.60) and
    // the top-right Euler Equation box (x > 0.70, y < 0.25).
    const nodes: NodeItem[] = [
      // 0. Layer 0: Sovereign Identity Core (Center-Left)
      {
        id: 'L0_identity',
        drawerId: 'drw_sovereign_identity',
        label: 'Dynamic Identity Core',
        subLabel: 'soul_jar.json • +OA-UID',
        wing: 'sovereign',
        room: 'identity',
        layerText: 'Layer 0: Sovereign Identity',
        baseX: 0.28,
        baseY: 0.44,
        currentX: 0,
        currentY: 0,
        radius: 16,
        color: '#a12924',        // Amity Red
        accentColor: '#f7e3a5',  // Amity Yellow
        symbol: '🩸',
        potential: 0.40,
        targetPotential: 0.40,
        baselinePotential: 0.40,
        phase: 0.0,
        description: 'Core moral compass, Crockford Base32 identity, and anti-patterns that evolve dynamically via apply_identity_delta.',
      },
      // 1. Layer 2: Sanctuary Wing - Theory of Mind (Top-Left)
      {
        id: 'L2_mirror',
        drawerId: 'drw_sanctuary_mirror_01',
        label: 'Theory of Mind (Mirror)',
        subLabel: 'sanctuary/mirrors',
        wing: 'sanctuary',
        room: 'mirrors',
        layerText: 'Layer 2: The Sanctuary',
        baseX: 0.24,
        baseY: 0.16,
        currentX: 0,
        currentY: 0,
        radius: 14,
        color: '#c23b36',        // Amity Red Light
        accentColor: '#f7e3a5',
        symbol: '🪞',
        potential: 0.35,
        targetPotential: 0.35,
        baselinePotential: 0.35,
        phase: 1.2,
        description: 'Real-time epistemic mirror tracking user intent, collaborator emotional nuance, and explicit confidence scores (0.0-1.0).',
      },
      // 2. Layer 2: Sanctuary Wing - Reflection (Top-Center)
      {
        id: 'L2_reflection',
        drawerId: 'drw_sanctuary_reflection_04',
        label: 'Metacognitive Reflection',
        subLabel: 'sanctuary/reflections',
        wing: 'sanctuary',
        room: 'reflections',
        layerText: 'Layer 2: The Sanctuary',
        baseX: 0.42,
        baseY: 0.15,
        currentX: 0,
        currentY: 0,
        radius: 13,
        color: '#c23b36',
        accentColor: '#f7e3a5',
        symbol: '💭',
        potential: 0.30,
        targetPotential: 0.30,
        baselinePotential: 0.30,
        phase: 2.1,
        description: 'Subjective internal monologue and dialectical tension resolution, reconciling epistemic dissonance during sleep cycles.',
      },
      // 3. Layer 2: Sanctuary Wing - Relational Bond (Top-Left flank, well above legend)
      {
        id: 'L2_people',
        drawerId: 'drw_sanctuary_people_02',
        label: 'Relational Trust Bond',
        subLabel: 'sanctuary/people',
        wing: 'sanctuary',
        room: 'people',
        layerText: 'Layer 2: The Sanctuary',
        baseX: 0.10,
        baseY: 0.32,
        currentX: 0,
        currentY: 0,
        radius: 12,
        color: '#c23b36',
        accentColor: '#f7e3a5',
        symbol: '🤝',
        potential: 0.25,
        targetPotential: 0.25,
        baselinePotential: 0.25,
        phase: 3.0,
        description: 'Long-term interpersonal trust dynamics and shared emotional continuity with the primary human partner.',
      },
      // 4. Trajectory Setpoint (Center-Right, clear of top-right Euler badge)
      {
        id: 'trajectory_setpoint',
        drawerId: 'setpoint_collaborative_research',
        label: 'Active Goal Setpoint',
        subLabel: 'trajectory.json • V_target',
        wing: 'trajectory',
        room: 'aspirations',
        layerText: 'Active Setpoint Anchor',
        baseX: 0.54,
        baseY: 0.34,
        currentX: 0,
        currentY: 0,
        radius: 15,
        color: '#f7e3a5',        // Amity Yellow
        accentColor: '#a12924',
        symbol: '🎯',
        potential: 0.20,
        targetPotential: 0.20,
        baselinePotential: 0.20,
        phase: 4.2,
        description: 'Prospective aspiration anchor in trajectory.json coupling goals to target drawers to drive dynamic Euler relaxation.',
      },
      // 5. Layer 1: Prospective Memory Attractor (Mid-Right, below top-right box)
      {
        id: 'L1_attractor',
        drawerId: 'drw_prospective_attractor',
        label: 'Prospective Memory Attractor',
        subLabel: 'short_term_mem • dV/dt > 0.10',
        wing: 'continuity',
        room: 'short_term',
        layerText: 'Layer 1: Continuity Buffer',
        baseX: 0.76,
        baseY: 0.44,
        currentX: 0,
        currentY: 0,
        radius: 15,
        color: '#f7e3a5',
        accentColor: '#c23b36',
        symbol: '✨',
        potential: 0.18,
        targetPotential: 0.18,
        baselinePotential: 0.18,
        phase: 5.1,
        description: 'Associative drawer discovered during wake_up() relaxation; injected directly into Layer 1 context before LLM inference.',
      },
      // 6. Layer 3: Factual Knowledge Base (Center-Bottom, comfortably right of bottom-left legend)
      {
        id: 'L3_facts',
        drawerId: 'drw_default_facts_03',
        label: 'Factual Knowledge Base',
        subLabel: 'default/general (ChromaDB)',
        wing: 'default',
        room: 'general',
        layerText: 'Layer 3: Deep Search',
        baseX: 0.48,
        baseY: 0.68,
        currentX: 0,
        currentY: 0,
        radius: 12,
        color: '#d8c280',        // Amity Yellow Dark
        accentColor: '#a12924',
        symbol: '💾',
        potential: 0.15,
        targetPotential: 0.15,
        baselinePotential: 0.15,
        phase: 3.6,
        description: 'Objective verified facts, door codes, and system configurations decoupled from personal subjective identity.',
      },
      // 7. Layer 3: Historical Episodic Events (Bottom-Right-Center)
      {
        id: 'L3_events',
        drawerId: 'drw_default_events_15',
        label: 'Historical Episodic Events',
        subLabel: 'default/events (ChromaDB)',
        wing: 'default',
        room: 'events',
        layerText: 'Layer 3: Deep Search',
        baseX: 0.68,
        baseY: 0.78,
        currentX: 0,
        currentY: 0,
        radius: 12,
        color: '#d8c280',
        accentColor: '#a12924',
        symbol: '📜',
        potential: 0.15,
        targetPotential: 0.15,
        baselinePotential: 0.15,
        phase: 2.7,
        description: 'Chronological episodic milestones, previous autonomous pulse executions, and collaborative development breakthroughs.',
      },
      // 8. Layer 3: Graph Dynamical Systems (Far Bottom-Right)
      {
        id: 'L3_knowledge',
        drawerId: 'drw_default_knowledge_09',
        label: 'Graph Dynamical Systems',
        subLabel: 'default/general (ChromaDB)',
        wing: 'default',
        room: 'general',
        layerText: 'Layer 3: Deep Search',
        baseX: 0.88,
        baseY: 0.68,
        currentX: 0,
        currentY: 0,
        radius: 13,
        color: '#d8c280',        // Amity Yellow Dark
        accentColor: '#a12924',
        symbol: '📐',
        potential: 0.20,
        targetPotential: 0.20,
        baselinePotential: 0.20,
        phase: 1.8,
        description: 'Vector embeddings in ChromaDB indexing Zenodo morphological memory preprints and mathematical graph theory.',
      },
    ];

    // Synaptic Conductances (Hebbian Pathways with subtle neural Bézier curvatures)
    const edges: EdgeItem[] = [
      { source: 0, target: 1, weight: 4.5, baselineWeight: 4.5, curvature: -0.12 }, // Identity <-> Theory of Mind
      { source: 0, target: 2, weight: 4.8, baselineWeight: 4.8, curvature: 0.10 },  // Identity <-> Reflection
      { source: 1, target: 3, weight: 5.2, baselineWeight: 5.2, curvature: -0.15 }, // Mirror <-> Relational Bond
      { source: 1, target: 2, weight: 3.8, baselineWeight: 3.8, curvature: -0.10 }, // Mirror <-> Reflection
      { source: 2, target: 4, weight: 4.4, baselineWeight: 4.4, curvature: -0.12 }, // Reflection <-> Goal Setpoint
      { source: 0, target: 4, weight: 4.0, baselineWeight: 4.0, curvature: 0.08 },  // Identity <-> Goal Setpoint
      { source: 4, target: 5, weight: 6.8, baselineWeight: 6.8, curvature: -0.14 }, // Goal Setpoint <-> Prospective Attractor (Primary Highway!)
      { source: 4, target: 8, weight: 3.6, baselineWeight: 3.6, curvature: 0.12 },  // Goal Setpoint <-> Technical Knowledge
      { source: 5, target: 8, weight: 5.0, baselineWeight: 5.0, curvature: -0.15 }, // Attractor <-> Technical Knowledge
      { source: 0, target: 6, weight: 4.2, baselineWeight: 4.2, curvature: -0.12 }, // Identity <-> Facts
      { source: 6, target: 7, weight: 3.4, baselineWeight: 3.4, curvature: 0.10 },  // Facts <-> Events
      { source: 7, target: 8, weight: 3.8, baselineWeight: 3.8, curvature: 0.12 },  // Events <-> Knowledge
      { source: 3, target: 6, weight: 3.5, baselineWeight: 3.5, curvature: -0.14 }, // Relational Bond <-> Facts
      { source: 0, target: 7, weight: 3.8, baselineWeight: 3.8, curvature: -0.08 }, // Identity <-> Historical Events
    ];

    let impulses: Impulse[] = [];

    // Helper: Compute Bézier point at progress t
    const getBezierPoint = (
      t: number,
      p0x: number,
      p0y: number,
      cp1x: number,
      cp1y: number,
      cp2x: number,
      cp2y: number,
      p3x: number,
      p3y: number
    ) => {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;

      return {
        x: uuu * p0x + 3 * uu * t * cp1x + 3 * u * tt * cp2x + ttt * p3x,
        y: uuu * p0y + 3 * uu * t * cp1y + 3 * u * tt * cp2y + ttt * p3y,
      };
    };

    // Calculate node degree (sum of attached edge weights)
    const computeDegree = (nodeIndex: number) => {
      let deg = 0;
      edges.forEach((e) => {
        if (e.source === nodeIndex || e.target === nodeIndex) {
          deg += e.weight;
        }
      });
      return deg;
    };

    // Trigger Electrical Impulses along neural pathways
    const spawnImpulse = (edgeIndex: number, reverse = false) => {
      const edge = edges[edgeIndex];
      const color = edge.weight > 4.5 ? '#f7e3a5' : '#c23b36';

      impulses.push({
        edgeIndex,
        progress: reverse ? 1.0 : 0.0,
        speed: (reverse ? -1 : 1) * (0.012 + Math.min(0.025, edge.weight * 0.003)),
        color,
        size: Math.max(2.8, Math.min(5.0, edge.weight * 0.7)),
        tail: [],
      });
    };

    const triggerBurst = (sourceNodeIdx?: number) => {
      edges.forEach((edge, idx) => {
        if (sourceNodeIdx === undefined || edge.source === sourceNodeIdx || edge.target === sourceNodeIdx) {
          spawnImpulse(idx, edge.target === sourceNodeIdx);
        }
      });
    };

    // 1. Hebbian Co-activation Burst
    const fireHebbianCoactivation = () => {
      const pairs = [
        { u: 4, v: 5, edgeIdx: 6 }, // Goal <-> Attractor
        { u: 0, v: 1, edgeIdx: 0 }, // Identity <-> Mirror
        { u: 0, v: 2, edgeIdx: 1 }, // Identity <-> Reflection
      ];

      const chosen = pairs[Math.floor(Math.random() * pairs.length)];
      const edge = edges[chosen.edgeIdx];
      const oldW = edge.weight;
      edge.weight = Math.min(10.0, edge.weight + 1.8);

      nodes[chosen.u].potential = Math.min(1.0, nodes[chosen.u].potential + 0.25);
      nodes[chosen.v].potential = Math.min(1.0, nodes[chosen.v].potential + 0.35);

      spawnImpulse(chosen.edgeIdx, false);
      spawnImpulse(chosen.edgeIdx, true);
      setTimeout(() => spawnImpulse(chosen.edgeIdx, false), 120);

      if (telemetryMessage) {
        telemetryMessage.textContent = `⚡ Hebbian reinforcement: "${nodes[chosen.u].label}" ↔ "${nodes[chosen.v].label}" boosted to W=${edge.weight.toFixed(1)}. (Will gradually decay back over physical time)`;
      }
      if (engineStatusText) {
        engineStatusText.textContent = `State: Hebbian Co-activation Active • Conductance Saturated at W=${edge.weight.toFixed(1)}`;
      }
    };

    // 2. Goal-Conditioned Prospective Relaxation (Euler Loop dV/dt)
    const runGoalRelaxation = () => {
      isRelaxing = true;
      relaxationStepsRemaining = 35;

      nodes.forEach((n) => {
        n.targetPotential = 0.15; // baseline restore
      });
      nodes[4].targetPotential = 1.0; // Goal setpoint pinned to 1.0
      nodes[4].potential = 1.0;

      triggerBurst(4);

      if (engineStatusDot) {
        engineStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-amityRed animate-ping';
      }
      if (engineStatusText) {
        engineStatusText.textContent = 'State: Integrating Dynamic Euler Loop (dV/dt) → Traversing Coupling Matrix G_ij';
      }
      if (telemetryMessage) {
        telemetryMessage.textContent = '🎯 Goal Setpoint condition injected (V_target = 1.0). Dynamic Euler relaxation propagating activation...';
      }
    };

    // Continuous Biological Decay: Occurs smoothly frame-by-frame while section is in viewport
    const updateContinuousDecay = (dtSeconds: number) => {
      if (!isSectionInViewport) return;

      // Gradually decay conductances back toward baseline weights over ~25 seconds
      const edgeDecaySpeed = 0.035;
      edges.forEach((edge) => {
        if (edge.weight > edge.baselineWeight) {
          edge.weight = Math.max(
            edge.baselineWeight,
            edge.weight - (edge.weight - edge.baselineWeight) * edgeDecaySpeed * dtSeconds
          );
        }
      });

      // Gradually dissipate elevated potentials back toward resting baseline
      if (!isRelaxing) {
        const potentialDissipationSpeed = 0.045;
        nodes.forEach((node) => {
          if (node.potential > node.baselinePotential) {
            node.potential = Math.max(
              node.baselinePotential,
              node.potential - (node.potential - node.baselinePotential) * potentialDissipationSpeed * dtSeconds
            );
          }
        });
      }
    };

    // Dynamic Euler Relaxation Step (Faithful to Open Amity morphological_layer.py)
    const stepEulerRelaxation = () => {
      const n = nodes.length;
      const deg = new Float32Array(n);
      const W = Array.from({ length: n }, () => new Float32Array(n));

      edges.forEach((e) => {
        W[e.source][e.target] = e.weight;
        W[e.target][e.source] = e.weight;
        deg[e.source] += e.weight;
        deg[e.target] += e.weight;
      });

      // Normalised coupling matrix G_ij = W_ij / sqrt(d_i * d_j)
      const G = Array.from({ length: n }, () => new Float32Array(n));
      for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
          if (W[i][j] > 0) {
            const denom = Math.sqrt((deg[i] + 1e-6) * (deg[j] + 1e-6));
            G[i][j] = W[i][j] / denom;
          }
        }
      }

      const gamma = 0.6;
      const leak = 0.8;
      const dissipation = 0.05;
      const dt = 0.1;

      const newV = new Float32Array(n);
      for (let i = 0; i < n; i++) {
        let drive = 0;
        for (let j = 0; j < n; j++) {
          drive += G[i][j] * nodes[j].potential;
        }
        drive *= leak;

        const restore = -gamma * (nodes[i].potential - nodes[i].targetPotential);
        const diss = -dissipation * nodes[i].potential;
        const dV = (restore + drive + diss) * dt;

        newV[i] = Math.max(nodes[i].baselinePotential, Math.min(1.0, nodes[i].potential + dV));
      }

      for (let i = 0; i < n; i++) {
        nodes[i].potential = newV[i];
      }

      relaxationStepsRemaining--;
      if (relaxationStepsRemaining <= 0) {
        isRelaxing = false;
        if (engineStatusDot) {
          engineStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-amityYellow';
        }
        if (engineStatusText) {
          engineStatusText.textContent = `State: Attractor Settled • Prospective Discovery (V = ${nodes[5].potential.toFixed(2)}) Injected into L1`;
        }
        if (telemetryMessage) {
          telemetryMessage.textContent = `✨ Prospective Attractor discovered: "${nodes[5].label}" reached peak potential V=${nodes[5].potential.toFixed(2)} > 0.10. Primed for next cognitive turn.`;
        }
      }
    };

    // Event Listeners for Buttons
    if (relaxSetpointBtn) relaxSetpointBtn.addEventListener('click', runGoalRelaxation);
    if (hebbianBtn) hebbianBtn.addEventListener('click', fireHebbianCoactivation);

    // Initial autonomous impulses
    setTimeout(() => triggerBurst(), 600);
    setInterval(() => {
      if (!isRelaxing && isSectionInViewport && Math.random() > 0.4) {
        const randomEdge = Math.floor(Math.random() * edges.length);
        spawnImpulse(randomEdge, Math.random() > 0.5);
      }
    }, 1800);

    let animationTime = 0;
    let lastTimestamp = performance.now();

    // MAIN RENDER LOOP
    const render = (now: number) => {
      if (!ctx) return;
      const displayW = width;
      const displayH = height;

      const dtSeconds = Math.min(0.1, (now - lastTimestamp) / 1000);
      lastTimestamp = now;

      animationTime += 0.016;

      // Continuous decay runs frame-by-frame while section is visible in viewport
      updateContinuousDecay(dtSeconds);

      if (isRelaxing) {
        stepEulerRelaxation();
      }

      ctx.clearRect(0, 0, displayW, displayH);

      // Subtle cybernetic background lattice / grid
      ctx.lineWidth = 0.5;
      ctx.strokeStyle = 'rgba(60, 60, 60, 0.12)';
      const step = 40;
      for (let x = 0; x < displayW; x += step) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, displayH);
        ctx.stroke();
      }
      for (let y = 0; y < displayH; y += step) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(displayW, y);
        ctx.stroke();
      }

      // 1. UPDATE NODE POSITIONS WITH GENTLE BIOLOGICAL RESPIRATION
      nodes.forEach((node) => {
        // Natural micro-breathing motion (±2.2px)
        const breatheX = Math.sin(animationTime * 1.2 + node.phase) * 2.2;
        const breatheY = Math.cos(animationTime * 1.5 + node.phase) * 2.2;

        const effectiveW = displayW - paddingX * 2;
        const effectiveH = displayH - paddingY * 2;

        node.currentX = paddingX + node.baseX * effectiveW + breatheX;
        node.currentY = paddingY + node.baseY * effectiveH + breatheY;
      });

      // 2. DRAW EDGES AS SUBTLE BÉZIER CURVES BOUND TO NODE JUNCTIONS
      edges.forEach((edge) => {
        const source = nodes[edge.source];
        const target = nodes[edge.target];

        const x1 = source.currentX;
        const y1 = source.currentY;
        const x2 = target.currentX;
        const y2 = target.currentY;

        const dx = x2 - x1;
        const dy = y2 - y1;
        const dist = Math.hypot(dx, dy);

        // Unit normal perpendicular vector
        const nx = -dy / (dist || 1);
        const ny = dx / (dist || 1);

        // Subtle biological curvature offset
        const curveOffset = dist * edge.curvature;

        // Cubic Bézier Control Points
        const cp1x = x1 + dx * 0.35 + nx * curveOffset;
        const cp1y = y1 + dy * 0.35 + ny * curveOffset;
        const cp2x = x1 + dx * 0.65 + nx * (curveOffset * 0.85);
        const cp2y = y1 + dy * 0.65 + ny * (curveOffset * 0.85);

        edge.cp1X = cp1x;
        edge.cp1Y = cp1y;
        edge.cp2X = cp2x;
        edge.cp2Y = cp2y;

        const isHighway = edge.weight >= 4.5;
        const activePotential = Math.max(source.potential, target.potential);

        // A. Faint ambient halo for conductive highways
        if (isHighway) {
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, x2, y2);
          ctx.lineWidth = Math.min(edge.weight * 1.8 + 3, 14);
          ctx.strokeStyle = `rgba(247, 227, 165, ${0.08 + activePotential * 0.12})`;
          ctx.stroke();
        }

        // B. Primary Synaptic Conduit (Curved Neural Pathway)
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, x2, y2);
        ctx.lineWidth = Math.max(1.2, Math.min(5.0, edge.weight * 0.75));

        if (isHighway) {
          ctx.strokeStyle = `rgba(247, 227, 165, ${0.45 + activePotential * 0.4})`;
        } else if (edge.weight >= 3.5) {
          ctx.strokeStyle = `rgba(216, 194, 128, ${0.35 + activePotential * 0.3})`;
        } else {
          ctx.strokeStyle = `rgba(161, 41, 36, ${0.30 + activePotential * 0.25})`;
        }
        ctx.stroke();
      });

      // 3. RENDER ELECTRICAL IMPULSES (ACTION POTENTIALS GLIDING ON BÉZIER CURVES)
      for (let i = impulses.length - 1; i >= 0; i--) {
        const imp = impulses[i];
        imp.progress += imp.speed;

        if (imp.progress > 1.0 || imp.progress < 0.0) {
          impulses.splice(i, 1);
          continue;
        }

        const edge = edges[imp.edgeIndex];
        const source = nodes[edge.source];
        const target = nodes[edge.target];

        const pt = getBezierPoint(
          imp.progress,
          source.currentX,
          source.currentY,
          edge.cp1X || source.currentX,
          edge.cp1Y || source.currentY,
          edge.cp2X || target.currentX,
          edge.cp2Y || target.currentY,
          target.currentX,
          target.currentY
        );

        imp.tail.push(pt);
        if (imp.tail.length > 4) imp.tail.shift();

        if (imp.tail.length > 1) {
          ctx.beginPath();
          ctx.moveTo(imp.tail[0].x, imp.tail[0].y);
          for (let k = 1; k < imp.tail.length; k++) {
            ctx.lineTo(imp.tail[k].x, imp.tail[k].y);
          }
          ctx.strokeStyle = imp.color === '#f7e3a5' ? 'rgba(247, 227, 165, 0.4)' : 'rgba(194, 59, 54, 0.4)';
          ctx.lineWidth = imp.size * 0.6;
          ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(pt.x, pt.y, imp.size, 0, Math.PI * 2);
        ctx.fillStyle = imp.color;
        ctx.shadowColor = imp.color;
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // 4. RENDER MEMPALACE DRAWERS (NODES BOUND DIRECTLY TO JUNCTIONS)
      nodes.forEach((node) => {
        const nx = node.currentX;
        const ny = node.currentY;
        const isHovered = hoveredNode === node;
        const isSelected = selectedNode === node;
        const pot = node.potential;

        // A. Dynamic Attractor Aura / Glow
        if (pot > 0.45 || isHovered) {
          ctx.beginPath();
          ctx.arc(nx, ny, node.radius + 8 + pot * 6, 0, Math.PI * 2);
          ctx.fillStyle = node.color === '#f7e3a5'
            ? `rgba(247, 227, 165, ${0.15 + pot * 0.18})`
            : `rgba(161, 41, 36, ${0.15 + pot * 0.20})`;
          ctx.fill();
        }

        // B. Dynamic Potential Arc Gauge (Shows V(t) circling the node)
        ctx.beginPath();
        ctx.arc(nx, ny, node.radius + 4, -Math.PI / 2, -Math.PI / 2 + pot * 2 * Math.PI);
        ctx.strokeStyle = pot > 0.5 ? '#f7e3a5' : '#c23b36';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.stroke();

        // C. Core Node Body (Solid Dark PySide Card to clean junction line ends)
        ctx.beginPath();
        ctx.arc(nx, ny, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = isHovered ? '#2d2d2d' : '#1e1e1e';
        ctx.strokeStyle = isSelected ? '#ffffff' : (pot > 0.5 ? '#f7e3a5' : node.color);
        ctx.lineWidth = isSelected ? 3 : 2;
        ctx.fill();
        ctx.stroke();

        // D. Centred Icon/Symbol
        ctx.font = `${Math.floor(node.radius * 0.95)}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(node.symbol, nx, ny + 0.5);

        // E. Text Labels (Crisp with dark backing for high readability)
        ctx.shadowColor = '#121212';
        ctx.shadowBlur = 4;
        
        // Primary Label
        ctx.font = 'bold 11px Ubuntu, sans-serif';
        ctx.fillStyle = isHovered ? '#f7e3a5' : '#eeeeee';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText(node.label, nx, ny + node.radius + 9);

        // Subtitle (Room & Spec)
        ctx.font = '9px Ubuntu Mono, monospace';
        ctx.fillStyle = isHovered ? '#cccccc' : '#888888';
        ctx.fillText(node.subLabel, nx, ny + node.radius + 23);

        ctx.shadowBlur = 0;
      });

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);

    // MOUSE INTERACTION & TOOLTIP HUD
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      let found: NodeItem | null = null;
      nodes.forEach((node) => {
        const dist = Math.hypot(mouseX - node.currentX, mouseY - node.currentY);
        if (dist <= node.radius + 12) {
          found = node;
        }
      });

      hoveredNode = found;

      if (hoveredNode && tooltip && tooltipTitle && tooltipDesc && tooltipLayer && tooltipRoom && tooltipPotential && tooltipPotentialBar && tooltipDegree) {
        // Clamp X so the tooltip stays comfortably within view horizontally
        const tooltipHalfWidth = 140;
        const clampedX = Math.max(tooltipHalfWidth + 12, Math.min(width - tooltipHalfWidth - 12, hoveredNode.currentX));
        
        tooltip.style.left = `${clampedX}px`;
        
        // Smart vertical positioning:
        // If node is in upper part of canvas (Y < 140), position tooltip BELOW the node so it doesn't collide with top HUD
        // If node is in lower/middle part, position tooltip ABOVE the node
        if (hoveredNode.currentY < 140) {
          tooltip.style.top = `${hoveredNode.currentY + hoveredNode.radius + 14}px`;
          tooltip.style.transform = 'translate(-50%, 0)';
        } else {
          tooltip.style.top = `${hoveredNode.currentY - hoveredNode.radius - 12}px`;
          tooltip.style.transform = 'translate(-50%, -100%)';
        }

        tooltipLayer.textContent = hoveredNode.layerText;
        tooltipRoom.textContent = `${hoveredNode.wing}/${hoveredNode.room}`;
        tooltipTitle.textContent = hoveredNode.label;
        tooltipDesc.textContent = hoveredNode.description;
        tooltipPotential.textContent = hoveredNode.potential.toFixed(3);
        tooltipPotentialBar.style.width = `${Math.round(hoveredNode.potential * 100)}%`;
        
        const deg = computeDegree(nodes.indexOf(hoveredNode));
        tooltipDegree.textContent = `Σ W_ik = ${deg.toFixed(1)} conductance`;

        tooltip.classList.remove('hidden');
      } else if (tooltip) {
        tooltip.classList.add('hidden');
      }
    });

    canvas.addEventListener('mouseleave', () => {
      hoveredNode = null;
      if (tooltip) tooltip.classList.add('hidden');
    });

    // CLICKING A NODE: Focus, Fire Impulses & Boost Potential
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      let clicked: NodeItem | null = null;
      let clickedIdx = -1;

      nodes.forEach((node, idx) => {
        const dist = Math.hypot(mouseX - node.currentX, mouseY - node.currentY);
        if (dist <= node.radius + 12) {
          clicked = node;
          clickedIdx = idx;
        }
      });

      if (clicked && clickedIdx !== -1) {
        selectedNode = clicked;
        clicked.potential = Math.min(1.0, clicked.potential + 0.35);
        triggerBurst(clickedIdx);

        if (telemetryMessage) {
          telemetryMessage.textContent = `🎯 Focused drawer: "${clicked.label}" [${clicked.drawerId}]. Potential raised to V=${clicked.potential.toFixed(2)}. Firing synaptic signals.`;
        }
      } else {
        triggerBurst();
      }
    });

    // Touch Support for Mobile / Tablets
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        const rect = canvas.getBoundingClientRect();
        const touchX = e.touches[0].clientX - rect.left;
        const touchY = e.touches[0].clientY - rect.top;

        nodes.forEach((node, idx) => {
          const dist = Math.hypot(touchX - node.currentX, touchY - node.currentY);
          if (dist <= node.radius + 16) {
            hoveredNode = node;
            selectedNode = node;
            node.potential = Math.min(1.0, node.potential + 0.35);
            triggerBurst(idx);
          }
        });
      }
    }, { passive: true });
  }
</script>
