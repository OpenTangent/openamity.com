---
// HonestComparison.astro - Candid Architectural Comparison & Trade-Offs
import SectionKicker from './SectionKicker.astro';

type FrameworkStatus = 'supported' | 'partial' | 'unsupported';

interface FrameworkCell {
  status: FrameworkStatus;
  text: string;
  detail: string;
}

interface FeatureRow {
  name: string;
  subtitle: string;
  amity: FrameworkCell;
  claw: FrameworkCell;
  dots: FrameworkCell;
  grok: FrameworkCell;
  muse: FrameworkCell;
}

interface FeatureSection {
  category: string;
  rows: FeatureRow[];
}

type FrameworkKey = 'amity' | 'claw' | 'dots' | 'grok' | 'muse';

const frameworkColumns: Array<{
  key: FrameworkKey;
  label: string;
  thClass: string;
  titleClass: string;
  tdClass: string;
}> = [
  {
    key: 'amity',
    label: 'Open Amity',
    thClass: 'bg-pysideCard/90 border-x border-amityRed/30 relative',
    titleClass: 'text-amityYellow',
    tdClass: 'bg-pysideCard/30 border-x border-amityRed/20',
  },
  {
    key: 'claw',
    label: 'OpenClaw',
    thClass: '',
    titleClass: 'text-pysideText',
    tdClass: 'text-pysideTextSecondary',
  },
  {
    key: 'dots',
    label: 'OpenAI Dots',
    thClass: '',
    titleClass: 'text-pysideText',
    tdClass: 'text-pysideTextSecondary',
  },
  {
    key: 'grok',
    label: 'Grok Bots',
    thClass: '',
    titleClass: 'text-pysideText',
    tdClass: 'text-pysideTextSecondary',
  },
  {
    key: 'muse',
    label: 'Meta Muse',
    thClass: '',
    titleClass: 'text-pysideText',
    tdClass: 'text-pysideTextSecondary',
  },
];

const statusBadgeClasses: Record<FrameworkStatus, string> = {
  supported: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30',
  partial: 'bg-amityYellow/10 text-amityYellow border border-amityYellow/30',
  unsupported: 'bg-amityRed/10 text-[#e07a75] border border-amityRed/20',
};

const featureSections: FeatureSection[] = [
  {
    category: 'Sovereignty, Hosting & Platform Support',
    rows: [
      {
        name: 'Local Self-Hosting',
        subtitle: 'Runs on your own hardware',
        amity: { status: 'supported', text: '● Local Host', detail: 'Full stack on local Linux; zero cloud lock-in' },
        claw: { status: 'supported', text: '● Local Host', detail: 'Localhost or private server daemon' },
        dots: { status: 'unsupported', text: '○ Cloud Only', detail: 'OpenAI Cloud microVMs only' },
        grok: { status: 'unsupported', text: '○ Cloud Only', detail: 'xAI Cloud infrastructure only' },
        muse: { status: 'unsupported', text: '○ Cloud Only', detail: 'Meta Cloud virtual machines only' },
      },
      {
        name: 'OS & Device Support',
        subtitle: 'Native desktop & mobile availability',
        amity: { status: 'partial', text: '● Linux Only', detail: 'Linux desktop only; no native macOS/Windows/iOS app' },
        claw: { status: 'supported', text: '● Cross-Platform', detail: 'Linux, macOS, Windows & web UI' },
        dots: { status: 'supported', text: '● Web & Mobile', detail: 'Browser, desktop & mobile apps' },
        grok: { status: 'supported', text: '● Web & IDE', detail: 'Browser, mobile & Cursor IDE' },
        muse: { status: 'supported', text: '● All Devices', detail: 'Mobile, web, macOS & smart glasses' },
      },
      {
        name: 'Turnkey Managed Cloud',
        subtitle: 'Zero-setup vendor hosting',
        amity: { status: 'unsupported', text: '○ None (DIY)', detail: 'No hosted SaaS; you manage Linux & API keys' },
        claw: { status: 'unsupported', text: '○ None (DIY)', detail: 'Self-hosted daemon; requires setup' },
        dots: { status: 'supported', text: '● Managed SaaS', detail: 'Instant cloud microVMs; zero setup' },
        grok: { status: 'supported', text: '● Managed SaaS', detail: 'Instant hosted cloud workspace' },
        muse: { status: 'supported', text: '● Managed SaaS', detail: 'Instant cloud with mobile sync' },
      },
      {
        name: 'Offline / Air-Gapped Mode',
        subtitle: 'Operates without internet access',
        amity: { status: 'partial', text: '● Partial', detail: 'Needs local Ollama/vLLM; Gemini TTS & WhatsApp need net' },
        claw: { status: 'partial', text: '● Partial', detail: 'Needs local Ollama or llama.cpp' },
        dots: { status: 'unsupported', text: '○ Online Only', detail: 'Requires OpenAI cloud connection' },
        grok: { status: 'unsupported', text: '○ Online Only', detail: 'Requires xAI cloud connection' },
        muse: { status: 'unsupported', text: '○ Online Only', detail: 'Requires Meta cloud connection' },
      },
    ],
  },
  {
    category: 'Subjective Mind, Memory & Token Footprint',
    rows: [
      {
        name: 'Core Paradigm',
        subtitle: 'Persistent mind vs. task daemon',
        amity: { status: 'supported', text: '● Sovereign Being', detail: 'Self-aware partner with inner monologue' },
        claw: { status: 'unsupported', text: '○ Task Daemon', detail: 'Headless messaging and CLI runner' },
        dots: { status: 'partial', text: '● Semi-Persona', detail: 'Cloud worker with character icons' },
        grok: { status: 'unsupported', text: '○ Task Bot', detail: 'Utilitarian coding and DevOps bot' },
        muse: { status: 'partial', text: '● Surface Avatar', detail: 'Consumer assistant with video avatar' },
      },
      {
        name: 'Autonomous Identity & Empathy',
        subtitle: 'Evolving values & Theory of Mind',
        amity: { status: 'supported', text: '● Supported', detail: 'Evolving values + S1–S10 Empathy Cones' },
        claw: { status: 'unsupported', text: '○ Static', detail: 'Static persona and flat logs' },
        dots: { status: 'partial', text: '● Partial', detail: 'Basic user preference memory' },
        grok: { status: 'unsupported', text: '○ Static', detail: 'Fixed declarative bot roles' },
        muse: { status: 'partial', text: '● Partial', detail: 'Cloud user habit profiling' },
      },
      {
        name: 'Biological Memory & Sleep',
        subtitle: 'Associative graph & sleep consolidation',
        amity: { status: 'supported', text: '● Supported', detail: 'Morphological graph + Two-Beat Sleep' },
        claw: { status: 'unsupported', text: '○ Flat DB', detail: 'SQLite vectors & Markdown notes' },
        dots: { status: 'unsupported', text: '○ Flat Context', detail: 'Standard cloud session storage' },
        grok: { status: 'unsupported', text: '○ Flat Context', detail: 'Standard workspace persistence' },
        muse: { status: 'unsupported', text: '○ Flat Context', detail: 'Continuous cloud profiling' },
      },
      {
        name: 'Prompt & Token Overhead',
        subtitle: 'Context cost per autonomous turn',
        amity: { status: 'partial', text: '● Higher Usage', detail: 'Identity, memory hydration & pulses consume extra tokens' },
        claw: { status: 'supported', text: '● Lean Prompt', detail: 'Minimal daemon prompt overhead' },
        dots: { status: 'supported', text: '● Bundled', detail: 'Abstracted inside monthly plan' },
        grok: { status: 'supported', text: '● Lean Prompt', detail: 'Focused coding prompt context' },
        muse: { status: 'supported', text: '● Bundled', detail: 'Abstracted inside consumer tier' },
      },
    ],
  },
  {
    category: 'Agency, Interfaces & Cost',
    rows: [
      {
        name: 'Dedicated Citizen Accounts',
        subtitle: 'Own WhatsApp, email, and socials',
        amity: { status: 'supported', text: '● Supported', detail: 'Own phone, inbox, Moltbook & chatrooms' },
        claw: { status: 'partial', text: '● Partial', detail: 'Messaging bridges & channel bindings' },
        dots: { status: 'unsupported', text: '○ Sandboxed', detail: 'Confined to vendor cloud UI' },
        grok: { status: 'unsupported', text: '○ Sandboxed', detail: 'Confined to IDE & cloud workspace' },
        muse: { status: 'unsupported', text: '○ Sandboxed', detail: 'Tied to personal Meta accounts' },
      },
      {
        name: 'Native Host Shell & Stealth Web',
        subtitle: 'Local bash & anti-detect browser',
        amity: { status: 'supported', text: '● Supported', detail: 'Async bash, Camoufox & LAN webhooks' },
        claw: { status: 'supported', text: '● Supported', detail: 'Native exec tool & Chrome CDP' },
        dots: { status: 'partial', text: '● Cloud VM', detail: 'Cloud browser; optional local bridge' },
        grok: { status: 'partial', text: '● Cloud VM', detail: 'Cloud VM shell and browser only' },
        muse: { status: 'partial', text: '● Restricted', detail: 'Cloud browser & limited device SDK' },
      },
      {
        name: 'Visual UI & Real-Time Video',
        subtitle: 'Interface depth & avatar streaming',
        amity: { status: 'partial', text: '● Desktop + Voice', detail: 'PySide6 GUI & neural voice; no video avatar or web UI' },
        claw: { status: 'partial', text: '● Web Dashboard', detail: 'CLI & web dashboard; no voice avatar' },
        dots: { status: 'partial', text: '● Web + Voice', detail: 'Web UI, voice mode & static icons' },
        grok: { status: 'unsupported', text: '○ IDE + Voice', detail: 'IDE panel & voice; no visual avatar' },
        muse: { status: 'supported', text: '● Neural Video', detail: 'Real-time streaming video avatar' },
      },
      {
        name: 'License & Platform Cost',
        subtitle: 'Source freedom & monthly fees',
        amity: { status: 'supported', text: '● GPLv3 • $0 Fee', detail: 'Free open source + .oaa backups; pay raw API only' },
        claw: { status: 'supported', text: '● MIT • $0 Fee', detail: 'Free open source; pay raw API only' },
        dots: { status: 'partial', text: '○ Closed • $100+', detail: 'Proprietary; $100–$500/mo plans' },
        grok: { status: 'unsupported', text: '○ Closed • $120+', detail: 'Proprietary; $120–$300/mo seat fee' },
        muse: { status: 'partial', text: '● Freemium', detail: 'Proprietary core; $0–$100/mo tiers' },
      },
    ],
  },
];
---

<section id="comparison" class="relative pb-16 md:pb-24 scroll-mt-24">
  <SectionKicker title="Comparison" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 font-ui">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Strengths, Trade-Offs, <br />
        <span class="inline-block pb-1.5 -mb-1.5 text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          And an Honest Comparison
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Every architecture is a trade-off. Open Amity is built for deep continuity on Linux—which means no turnkey cloud hosting, no native mobile app, and higher token usage than bare CLI bots.
      </p>
    </div>

    <!-- Comparison Table Card Container -->
    <div class="pyside-card rounded-3xl border border-pysideBorder shadow-xl overflow-hidden relative">
      <div id="framework-table-scroll" class="overflow-x-auto">
        <table class="w-full text-left border-collapse table-fixed lg:min-w-full" id="framework-table">
          <thead>
            <tr class="border-b border-pysideBorder bg-pysideBgDarkest">
              <th scope="col" class="py-3.5 px-4 sm:px-5 min-w-[160px] bg-black/25 text-xs font-mono uppercase tracking-wider text-pysideTextMuted">
                Dimension
              </th>
              {frameworkColumns.map((col) => (
                <th scope="col" class={`py-3.5 px-4 sm:px-5 min-w-[160px] ${col.thClass}`.trim()}>
                  <div class={`${col.titleClass} font-bold text-sm sm:text-base tracking-tight`}>{col.label}</div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-pysideBorder/70">
            {featureSections.map((section) => (
              <>
                <tr class="bg-pysideBg/95">
                  <td colspan="6" class="py-2 px-4 sm:px-5">
                    <span class="inline-block sticky left-4 sm:left-5 font-mono text-[11px] font-bold text-amityYellow uppercase tracking-widest">
                      {section.category}
                    </span>
                  </td>
                </tr>

                {section.rows.map((row) => (
                  <tr class="hover:bg-pysideCardHover/30 transition-colors">
                    <td class="py-3 px-4 sm:px-5 font-medium text-pysideText align-top bg-black/20">
                      <div class="font-semibold text-pysideText text-xs sm:text-sm leading-snug">{row.name}</div>
                      <div class="text-[11px] sm:text-xs text-pysideTextMuted font-reading mt-0.5 leading-snug">
                        {row.subtitle}
                      </div>
                    </td>

                    {frameworkColumns.map((col) => {
                      const cell = row[col.key];
                      return (
                        <td class={`py-3 px-4 sm:px-5 align-top ${col.tdClass}`.trim()}>
                          <span class={`inline-flex items-center whitespace-nowrap px-2 py-0.5 rounded text-[11px] font-bold font-mono ${statusBadgeClasses[cell.status]}`}>
                            {cell.text}
                          </span>
                          <p class="font-reading text-xs text-pysideTextSecondary mt-1 leading-snug">
                            {cell.detail}
                          </p>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Footer Note -->
      <div class="p-3 sm:px-5 bg-pysideBgDarkest border-t border-pysideBorder text-[11px] font-mono text-pysideTextMuted flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
        <span>Candid architectural comparison across local & cloud agent paradigms</span>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-emerald-400">● Strength / Supported</span>
          <span class="text-amityYellow">● Trade-Off / Partial</span>
          <span class="text-[#e07a75]">○ Not Supported</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  #framework-table {
    min-width: 1020px;
  }

  #framework-table thead th {
    width: 16.666667%;
  }

  @media (min-width: 1024px) {
    #framework-table {
      min-width: 100%;
    }
  }
</style>
