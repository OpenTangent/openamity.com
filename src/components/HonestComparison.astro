<!-- Mobile Column Visibility Script -->
<script>
  function setupMobileTableFilter() {
    const btnDefault = document.getElementById('btn-filter-default');
    const btnOss = document.getElementById('btn-filter-oss');
    const btnAll = document.getElementById('btn-filter-all');
    const buttons = [btnDefault, btnOss, btnAll];

    const clawCells = document.querySelectorAll('.col-framework-claw');
    const dotsCells = document.querySelectorAll('.col-framework-dots');
    const grokCells = document.querySelectorAll('.col-framework-grok');
    const museCells = document.querySelectorAll('.col-framework-muse');

    function setActiveBtn(activeBtn: HTMLElement | null) {
      buttons.forEach(btn => {
        if (!btn) return;
        if (btn === activeBtn) {
          btn.classList.add('active', 'text-white', 'bg-pysideCard', 'border-amityYellow/50');
          btn.classList.remove('text-pysideTextMuted', 'bg-pysideBg', 'border-pysideBorder');
        } else {
          btn.classList.remove('active', 'text-white', 'bg-pysideCard', 'border-amityYellow/50');
          btn.classList.add('text-pysideTextMuted', 'bg-pysideBg', 'border-pysideBorder');
        }
      });
    }

    if (btnDefault) {
      btnDefault.addEventListener('click', () => {
        setActiveBtn(btnDefault);
        // Show Amity, Dots, Grok; Hide Claw, Muse on mobile
        clawCells.forEach(el => { el.classList.add('hidden'); el.classList.remove('table-cell'); });
        museCells.forEach(el => { el.classList.add('hidden'); el.classList.remove('table-cell'); });
        dotsCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
        grokCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
      });
    }

    if (btnOss) {
      btnOss.addEventListener('click', () => {
        setActiveBtn(btnOss);
        // Show Amity & OpenClaw; Hide Dots, Grok, Muse on mobile
        clawCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
        dotsCells.forEach(el => { el.classList.add('hidden'); el.classList.remove('table-cell'); });
        grokCells.forEach(el => { el.classList.add('hidden'); el.classList.remove('table-cell'); });
        museCells.forEach(el => { el.classList.add('hidden'); el.classList.remove('table-cell'); });
      });
    }

    if (btnAll) {
      btnAll.addEventListener('click', () => {
        setActiveBtn(btnAll);
        // Show all columns
        clawCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
        dotsCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
        grokCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
        museCells.forEach(el => { el.classList.remove('hidden'); el.classList.add('table-cell'); });
      });
    }
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileTableFilter);
  } else {
    setupMobileTableFilter();
  }
</script>
