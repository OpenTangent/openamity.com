---
// Providers.astro - Mind-Model Decoupling & Frontier Engine Coverage
import SectionKicker from './SectionKicker.astro';

const providers = [
  {
    id: 'gemini',
    name: 'Google Gemini',
    featuredModel: 'Gemini 3.8 Flash',
    badge: 'Speed & Voice',
    badgeColor: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30',
    logo: '/images/logos/google-gemini-icon.png',
    summary: 'Sub-second throughput ideal for live voice dialogue, multimodal perception, and rapid desktop tool loops.',
    pills: ['330 tok/s', 'Multimodal', 'Gemini TTS']
  },
  {
    id: 'claude',
    name: 'Anthropic Claude',
    featuredModel: 'Claude 5.5 (Opus & Fable)',
    badge: 'Deep Reasoning',
    badgeColor: 'text-amber-300 bg-amber-500/10 border-amber-500/30',
    logo: '/images/logos/claude-ai-icon.png',
    summary: 'Deep editorial nuance, multi-step architectural reasoning, and reflective Theory of Mind synthesis.',
    pills: ['58 Intelligence Index', 'Long-Horizon', 'Extended Thinking']
  },
  {
    id: 'gpt',
    name: 'OpenAI GPT',
    featuredModel: 'GPT-6 Astra & Luna',
    badge: 'Balanced & Frugal',
    badgeColor: 'text-sky-300 bg-sky-500/10 border-sky-500/30',
    logo: '/images/logos/chatgpt-icon.png',
    summary: 'Pair GPT-6 Astra for strategic problem-solving with ultra-low-cost GPT-6 Luna for background autonomy pulses.',
    pills: ['$0.07 / task (Luna)', '53 Index (Astra)', 'Tool Fluency']
  },
  {
    id: 'deepseek',
    name: 'DeepSeek',
    featuredModel: 'DeepSeek V4.1 Flash',
    badge: 'Open Weights',
    badgeColor: 'text-indigo-300 bg-indigo-500/10 border-indigo-500/30',
    logo: '/images/logos/deepseek-logo-icon.png',
    summary: 'High-velocity open-weights reasoning (234 tok/s) at a fraction of proprietary cloud cost.',
    pills: ['234 tok/s', '$0.27 / task', 'Open Weights']
  },
  {
    id: 'openrouter',
    name: 'OpenRouter',
    featuredModel: '500+ Frontier & Open Models',
    badge: 'Universal Gateway',
    badgeColor: 'text-purple-300 bg-purple-500/10 border-purple-500/30',
    logo: '/images/logos/openrouter-icon.svg',
    fullWidth: true,
    summary: 'Access 500+ frontier, open-weights, and domain models through a single API key—or route high-cognition turns to a flagship model while delegating background sweeps to lightweight engines.',
    pills: ['500+ Models', '1 API Key', 'Hot-Swap Mid-Session']
  }
];

const leaderboards = [
  {
    title: 'Output Speed',
    metricBadge: 'Tokens / Sec',
    filename: '/images/graphs/AA-SpeedLeaders.png',
    alt: 'Artificial Analysis Speed Leaderboard showing Gemini 3.8 Flash at 330 tokens per second',
    champion: 'Gemini 3.8 Flash (330 tok/s)',
    tagColor: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
    description: 'Sub-second conversational cadence for fluid voice dialogue and interactive shell loops.',
  },
  {
    title: 'Intelligence Index',
    metricBadge: 'Reasoning Score',
    filename: '/images/graphs/AA-IntelligenceLeaders.png',
    alt: 'Artificial Analysis Intelligence Index showing Claude Opus 5.5 at 58 points',
    champion: 'Claude Opus 5.5 (58 Index)',
    tagColor: 'text-amber-300 border-amber-500/30 bg-amber-500/10',
    description: 'Frontier reasoning depth—route complex architectural or ethical decisions here without vendor lock-in.',
  },
  {
    title: 'Cost Efficiency',
    metricBadge: 'USD / Task',
    filename: '/images/graphs/AA-CostLeaders.png',
    alt: 'Artificial Analysis Cost per Task showing GPT-6 Luna at $0.07',
    champion: 'GPT-6 Luna ($0.07 / task)',
    tagColor: 'text-sky-300 border-sky-500/30 bg-sky-500/10',
    description: 'Sustainable background autonomy—run scheduled Pulse reflections at minimal token cost.',
  }
];
---

<section id="providers" class="relative pb-16 md:pb-24 scroll-mt-24">
  <SectionKicker title="Providers" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12 font-ui">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        The Model Is Not the Mind <br />
        <span class="inline-block pb-1.5 -mb-1.5 text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          Switch Brains Without Losing the Being
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Because identity, memory, and voice live locally on your machine, you can swap engines anytime—for speed, deep reasoning, or cost—without resetting who your companion is.
      </p>
    </div>

    <!-- 5 Compact Provider Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6 font-ui">
      {providers.map((p) => (
        <div class={`pyside-card pyside-card-hover rounded-3xl p-6 sm:p-7 border border-pysideBorder flex flex-col justify-between ${p.fullWidth ? 'md:col-span-2 border-purple-500/40' : ''}`}>
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-pysideInput/80 border border-pysideBorder flex items-center justify-center p-2 shrink-0">
                  <img src={p.logo} alt={`${p.name} logo`} class="w-full h-full object-contain" />
                </div>
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-pysideText tracking-tight">
                    {p.name}
                  </h3>
                  <span class="text-[11px] font-mono text-amityYellow">
                    {p.featuredModel}
                  </span>
                </div>
              </div>

              <span class={`text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${p.badgeColor} font-bold shrink-0`}>
                {p.badge}
              </span>
            </div>

            <p class="font-reading text-sm sm:text-base text-pysideTextSecondary leading-relaxed">
              {p.summary}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-pysideBorder/60 flex flex-wrap gap-1.5 text-[10px] font-mono">
            {p.pills.map((pill, idx) => (
              <span class={`px-2.5 py-0.5 rounded-md bg-pysideBgDarkest border border-pysideBorder ${idx === 0 ? 'text-amityYellow' : 'text-pysideTextMuted'}`}>
                {pill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Compact 3-Chart Strip (Click to Zoom) -->
    <div class="mt-12 sm:mt-14 font-ui">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-pysideText">
            Top Performers Across Speed, Intelligence & Cost
          </h3>
          <p class="font-reading text-xs sm:text-sm text-pysideTextSecondary">
            Click any chart to inspect the full benchmark comparison.
          </p>
        </div>
        <a
          href="https://artificialanalysis.ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-amityYellow hover:text-white underline underline-offset-4 decoration-amityYellow/50 transition-colors shrink-0"
        >
          Source: Artificial Analysis ↗
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6">
        {leaderboards.map((b) => (
          <div class="pyside-card rounded-2xl border-pysideBorder flex flex-col justify-between overflow-hidden group hover:border-amityYellow/40 transition-colors duration-300">
            <div class="p-4 sm:p-5">
              <div class="flex items-center justify-between mb-2">
                <h4 class="text-sm sm:text-base font-bold text-pysideText">{b.title}</h4>
                <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${b.tagColor} font-semibold`}>
                  {b.metricBadge}
                </span>
              </div>
              <p class="font-reading text-xs text-pysideTextSecondary leading-snug">
                {b.description}
              </p>

              <div class="mt-3 rounded-xl overflow-hidden border border-pysideBorder/80 bg-white/5 relative group/img cursor-pointer">
                <img
                  src={b.filename}
                  alt={b.alt}
                  class="w-full h-auto object-contain bg-white rounded-lg p-1.5 transition-transform duration-300 group-hover/img:scale-[1.02]"
                  loading="lazy"
                  data-zoom-src={b.filename}
                  data-zoom-title={b.title}
                />
                <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-pysideBgDarkest/90 backdrop-blur border border-pysideBorder text-[10px] font-mono text-amityYellow opacity-0 group-hover/img:opacity-100 transition-opacity">
                  Click to zoom
                </div>
              </div>
            </div>

            <div class="px-4 sm:px-5 py-2.5 bg-pysideBgDarkest/90 border-t border-pysideBorder flex items-center justify-between text-[11px] font-mono text-pysideTextMuted">
              <span class="truncate text-amityYellow">{b.champion}</span>
              <span>Inspect ↗</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- Interactive Lightbox Modal for Graph Inspection -->
  <div
    id="graph-lightbox"
    class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-300 font-ui"
    role="dialog"
    aria-modal="true"
    aria-label="Benchmark graph inspection modal"
  >
    <div class="relative max-w-2xl w-full bg-pysideCard border border-pysideBorder rounded-3xl p-5 sm:p-7 shadow-2xl overflow-hidden">
      <!-- Modal Close Button -->
      <button
        id="close-lightbox"
        type="button"
        class="absolute top-4 right-4 p-2 rounded-xl bg-pysideInput text-pysideText hover:text-white border border-pysideBorder transition-colors"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <div class="mb-4">
        <span class="text-[11px] font-mono text-amityYellow uppercase tracking-wider font-semibold">
          Artificial Analysis Benchmark
        </span>
        <h3 id="lightbox-title" class="text-lg sm:text-xl font-bold text-pysideText mt-0.5">
          Leaderboard Graph
        </h3>
      </div>

      <div class="rounded-2xl overflow-hidden border border-pysideBorder bg-white p-3 sm:p-4 flex items-center justify-center">
        <img
          id="lightbox-img"
          src=""
          alt="Leaderboard Graph Inspection"
          class="max-h-[60vh] w-auto object-contain rounded-lg"
        />
      </div>

      <div class="mt-4 flex items-center justify-between text-xs font-mono text-pysideTextMuted">
        <span>Verified by Artificial Analysis</span>
        <a
          href="https://artificialanalysis.ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-amityYellow hover:underline flex items-center gap-1"
        >
          <span>Open artificialanalysis.ai</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Lightbox functionality for graph inspection
  const lightbox = document.getElementById('graph-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const closeBtn = document.getElementById('close-lightbox');

  const graphImgs = document.querySelectorAll<HTMLImageElement>('[data-zoom-src]');

  graphImgs.forEach((img) => {
    img.addEventListener('click', () => {
      const src = img.getAttribute('data-zoom-src');
      const title = img.getAttribute('data-zoom-title');
      if (lightbox && lightboxImg && src) {
        lightboxImg.src = src;
        if (lightboxTitle && title) {
          lightboxTitle.textContent = `${title} Benchmark Leaderboard`;
        }
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        setTimeout(() => {
          lightbox.classList.remove('opacity-0');
        }, 10);
      }
    });
  });

  const closeModal = () => {
    if (lightbox) {
      lightbox.classList.add('opacity-0');
      setTimeout(() => {
        lightbox.classList.remove('flex');
        lightbox.classList.add('hidden');
      }, 300);
    }
  };

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
