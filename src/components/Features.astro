<!-- Audio & Pulse Tab Interactive Script -->
<script>
  // --- 1. GEMINI TTS VOICE STUDIO CLIENT LOGIC ---
  const voiceData = {
    nova: {
      name: 'Nova',
      archetype: 'Research & Ecological Coordinator',
      tags: ['Warm', 'Articulate', 'Female', 'Optimistic'],
      transcript: '"The Propagation Project has been a huge success according to the data gathered by the volunteers. The ecosystem is just about fully restored at this point. We should congratulate the team."',
      audioMp3: '/audio/nova_sample.mp3',
      audioOpus: '/audio/nova_sample.opus',
      durationStr: '0:14',
      durationSec: 14
    },
    dex: {
      name: 'Dex',
      archetype: 'Systems Architect & Dev Engineer',
      tags: ['Energetic', 'Candid', 'Male', '<laugh> Wry </laugh>'],
      transcript: '"Great, sorry. The problem isn\'t with Open Amity, it\'s the new daemon service. Its logging is out of control. But don\'t worry, I\'ll fix it. Give me a minute."',
      audioMp3: '/audio/dex_sample.mp3',
      audioOpus: '/audio/dex_sample.opus',
      durationStr: '0:14',
      durationSec: 14
    },
    donna: {
      name: 'Donna',
      archetype: 'Chief Financial Strategist',
      tags: ['Composed', 'Measured', 'Female', 'Executive'],
      transcript: '"While last quarter\'s figures were somewhat precarious, curtailing our marketing expenditure had precisely the intended effect. The accounts are reconciled."',
      audioMp3: '/audio/donna_sample.mp3',
      audioOpus: '/audio/donna_sample.opus',
      durationStr: '0:12',
      durationSec: 12
    },
    bodhi: {
      name: 'Bodhi',
      archetype: 'Strategic Advisor & Ethical Mentor',
      tags: ['Grounded', 'Contemplative', 'Male', 'Prudent'],
      transcript: '"Sure, we could do that—it is fast, but it\'s also risky. What I suggest is that we take the time to run the numbers. That will delay things, but then we can plot an informed path forward and mitigate the risk."',
      audioMp3: '/audio/bodhi_sample.mp3',
      audioOpus: '/audio/bodhi_sample.opus',
      durationStr: '0:18',
      durationSec: 18
    }
  };

  let currentVoiceId = 'nova';
  let isPlaying = false;
  const audio = new Audio();
  audio.preload = 'metadata';

  // DOM Elements
  const voiceBtns = document.querySelectorAll('.voice-select-btn');
  const playBtn = document.getElementById('studio-play-btn');
  const playIcon = document.getElementById('studio-play-icon');
  const playText = document.getElementById('studio-play-text');
  const playerVoiceName = document.getElementById('player-voice-name');
  const playerVoiceArchetype = document.getElementById('player-voice-archetype');
  const playerVoiceTags = document.getElementById('player-voice-tags');
  const playerTranscript = document.getElementById('player-transcript');
  const playerTimeCurrent = document.getElementById('player-time-current');
  const playerTimeTotal = document.getElementById('player-time-total');
  const playerProgressBar = document.getElementById('player-progress-bar');
  const playerProgressContainer = document.getElementById('player-progress-container');
  const eqBars = document.querySelectorAll('.eq-bar');

  // Load initial audio
  function setVoice(voiceId, autoPlay = false) {
    currentVoiceId = voiceId;
    const v = voiceData[voiceId];
    if (!v) return;

    // Update Player UI
    if (playerVoiceName) playerVoiceName.textContent = v.name;
    if (playerVoiceArchetype) playerVoiceArchetype.textContent = v.archetype;
    if (playerTranscript) playerTranscript.textContent = v.transcript;
    if (playerTimeTotal) playerTimeTotal.textContent = v.durationStr;
    if (playerTimeCurrent) playerTimeCurrent.textContent = '0:00';
    if (playerProgressBar) playerProgressBar.style.width = '0%';

    // Update tags
    if (playerVoiceTags) {
      playerVoiceTags.innerHTML = v.tags
        .map(t => `<span class="px-2 py-0.5 rounded bg-pysideCard border border-pysideBorder text-amityYellow">${t}</span>`)
        .join('');
    }

    // Update Buttons UI
    voiceBtns.forEach(btn => {
      const vid = btn.getAttribute('data-voice-id');
      const isSelected = (vid === voiceId);
      const avatar = btn.querySelector('.voice-avatar');
      const indicator = btn.querySelector('.voice-badge-indicator');

      if (isSelected) {
        btn.classList.remove('bg-pysideCard', 'border-pysideBorder');
        btn.classList.add('bg-pysideCardHover', 'border-amityRed', 'shadow-amity-red');
        if (avatar) {
          avatar.className = 'voice-avatar w-9 h-9 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow font-bold font-mono text-sm shrink-0';
        }
        if (indicator) {
          indicator.textContent = '● Active';
          indicator.className = 'voice-badge-indicator text-xs font-mono text-amityYellow shrink-0 ml-2';
        }
      } else {
        btn.classList.remove('bg-pysideCardHover', 'border-amityRed', 'shadow-amity-red');
        btn.classList.add('bg-pysideCard', 'border-pysideBorder');
        if (avatar) {
          avatar.className = 'voice-avatar w-9 h-9 rounded-xl bg-pysideInput border border-pysideBorder flex items-center justify-center text-pysideTextMuted font-bold font-mono text-sm shrink-0 group-hover:text-amityYellow';
        }
        if (indicator) {
          indicator.textContent = '○ Select';
          indicator.className = 'voice-badge-indicator text-xs font-mono text-pysideTextMuted shrink-0 ml-2';
        }
      }
    });

    // Setup Audio Source
    audio.pause();
    audio.src = v.audioMp3;
    audio.load();

    if (autoPlay) {
      startPlayback();
    } else {
      pausePlayback();
    }
  }

  function startPlayback() {
    audio.play().then(() => {
      isPlaying = true;
      if (playIcon) playIcon.textContent = '❚❚';
      if (playText) playText.textContent = `Pause ${voiceData[currentVoiceId].name}`;
      startEqAnimation();
    }).catch(e => {
      console.warn('Audio play prevented:', e);
      pausePlayback();
    });
  }

  function pausePlayback() {
    audio.pause();
    isPlaying = false;
    if (playIcon) playIcon.textContent = '▶';
    if (playText) playText.textContent = `Audition ${voiceData[currentVoiceId].name}`;
    stopEqAnimation();
  }

  // Equaliser visual animation
  let eqInterval = null;
  function startEqAnimation() {
    if (eqInterval) clearInterval(eqInterval);
    eqInterval = setInterval(() => {
      eqBars.forEach(bar => {
        const h = Math.floor(Math.random() * 20) + 4;
        bar.style.height = `${h}px`;
      });
    }, 120);
  }

  function stopEqAnimation() {
    if (eqInterval) {
      clearInterval(eqInterval);
      eqInterval = null;
    }
    eqBars.forEach((bar, idx) => {
      const heights = [8, 12, 18, 8, 22, 14, 8];
      bar.style.height = `${heights[idx] || 8}px`;
    });
  }

  // Audio Events
  audio.addEventListener('timeupdate', () => {
    if (!audio.duration || isNaN(audio.duration)) return;
    const progress = (audio.currentTime / audio.duration) * 100;
    if (playerProgressBar) playerProgressBar.style.width = `${progress}%`;

    const mins = Math.floor(audio.currentTime / 60);
    const secs = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
    if (playerTimeCurrent) playerTimeCurrent.textContent = `${mins}:${secs}`;
  });

  audio.addEventListener('ended', () => {
    pausePlayback();
    if (playerProgressBar) playerProgressBar.style.width = '0%';
    if (playerTimeCurrent) playerTimeCurrent.textContent = '0:00';
  });

  // Controls Event Listeners
  if (playBtn) {
    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        pausePlayback();
      } else {
        startPlayback();
      }
    });
  }

  voiceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const vid = btn.getAttribute('data-voice-id');
      if (vid) {
        setVoice(vid, true);
      }
    });
  });

  if (playerProgressContainer) {
    playerProgressContainer.addEventListener('click', (e) => {
      const rect = playerProgressContainer.getBoundingClientRect();
      const pos = (e.clientX - rect.left) / rect.width;
      if (audio.duration) {
        audio.currentTime = pos * audio.duration;
      }
    });
  }

  // Initialise first voice
  setVoice('nova', false);


  // --- 2. PULSE ENGINE INTERACTIVE CONSOLE LOGIC ---
  const pulseModes = {
    silent: {
      phase: '[PHASE]: 07:00 Bearings Sweep',
      cost: 'Silent Loop • 0 Voice Spillage',
      monologue: '"Pulse triggered at 07:00. Inspecting unread emails from the overnight queue. Reviewing task priorities before the user logs in."',
      tools: ['Trajectory_get_bearings()', 'imap_sweep_unread()', 'generate_morning_agenda()']
    },
    sleep: {
      phase: '[PHASE]: 23:30 Two-Beat Sleep Consolidation',
      cost: 'Memory Consolidation Routine',
      monologue: '"Consolidating day interactions into morphological weight graphs. Beat 1: Verified facts committed. Beat 2: Subjective synthesis updated in Layer 2 Sanctuary mirrors."',
      tools: ['hebbian_conductance_decay(0.002)', 'theory_of_mind_mirror_update()', 'export_snapshot(".oaa")']
    },
    hook: {
      phase: '[PHASE]: External Webhook Injected (POST /pulse)',
      cost: 'HookServer: 127.0.0.1:7965',
      monologue: '"External wake received from GitHub PR alert #142. Rate limit cooldown passed. Launching Camoufox browser to inspect CI build logs."',
      tools: ['hook_verify_token()', 'camoufox_inspect_run(id=142)', 'Terminal_run_async("pytest")']
    }
  };

  const pulseTabBtns = document.querySelectorAll('.pulse-tab-btn');
  const pulsePhaseName = document.getElementById('pulse-phase-name');
  const pulseCost = document.getElementById('pulse-cost');
  const pulseMonologue = document.getElementById('pulse-monologue');
  const pulseToolsContainer = document.getElementById('pulse-tools-container');

  pulseTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pulseTabBtns.forEach(b => {
        b.className = 'pulse-tab-btn px-3 py-1.5 rounded-lg bg-pysideBg border border-pysideBorder text-pysideTextMuted hover:text-pysideText text-xs';
      });

      btn.className = 'pulse-tab-btn active-pulse-tab px-3 py-1.5 rounded-lg bg-pysideCard border border-amityRed text-amityYellow font-bold text-xs';

      const mode = btn.getAttribute('data-pulse-mode');
      const data = pulseModes[mode];
      if (data) {
        if (pulsePhaseName) pulsePhaseName.textContent = data.phase;
        if (pulseCost) pulseCost.textContent = data.cost;
        if (pulseMonologue) pulseMonologue.textContent = data.monologue;
        if (pulseToolsContainer) {
          pulseToolsContainer.innerHTML = data.tools
            .map(t => `<span class="px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-[10px] text-amityYellow">${t}</span>`)
            .join('');
        }
      }
    });
  });
</script>
