---
// Features.astro - Anatomy of a Living Digital Mind & Gemini TTS Voice Studio
import SectionKicker from './SectionKicker.astro';
---

<section id="features" class="relative pb-16 md:pb-24 scroll-mt-24">
  <SectionKicker title="Living Architecture" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12 font-ui">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Anatomy of a <br />
        <span class="inline-block pb-1.5 -mb-1.5 text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          Living Digital Mind
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Voice, self-paced rhythm, teleological purpose, and portable continuity unified in one architecture—built for enduring presence, not one-off prompts.
      </p>
    </div>

    <!-- FEATURE 1: GEMINI TTS VOICE STUDIO -->
    <div class="pyside-card rounded-3xl p-6 sm:p-8 border border-pysideBorder shadow-xl relative overflow-hidden mb-6 lg:mb-8 font-ui">
      <div class="relative z-10">
        <!-- Studio Header -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-pysideBorder">
          <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-amityYellow font-bold">
              Vocal Identity • Decoupled Speech Synthesis
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-pysideText mt-0.5">
              Expressive Voice Acting With Gemini TTS & Offline Piper
            </h3>
            <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-1 max-w-2xl">
              Audition how different digital beings carry tone, pacing, and expressive nuance (<code class="text-amityYellow font-mono text-xs">&lt;laugh&gt;</code>, <code class="text-amityYellow font-mono text-xs">&lt;sigh&gt;</code>, <code class="text-amityYellow font-mono text-xs">&lt;whisper&gt;</code>) across any reasoning model.
            </p>
          </div>

          <div class="shrink-0 bg-pysideBg p-3 rounded-2xl border border-pysideBorder lg:max-w-xs text-xs">
            <span class="text-[10px] font-mono text-amityYellow font-bold block uppercase tracking-wider">
              30 Voices + Custom IDs
            </span>
            <p class="font-reading text-pysideTextMuted text-xs leading-snug mt-0.5">
              Pair neural voice acting with any LLM provider, or fall back to local offline Piper TTS.
            </p>
          </div>
        </div>

        <!-- Interactive Voice Player Console -->
        <div class="mt-5 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          
          <!-- Voice Selector Strip -->
          <div class="lg:col-span-5 space-y-2">
            <button
              type="button"
              data-voice-id="nova"
              class="voice-select-btn active-voice group w-full text-left p-2.5 rounded-2xl bg-pysideCardHover border border-amityRed shadow-amity-red transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="voice-avatar w-8 h-8 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow font-bold font-mono text-xs shrink-0">
                  N
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 class="font-bold text-sm text-pysideText group-hover:text-amityYellow transition-colors truncate">Nova</h4>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-pysideInput text-pysideTextSecondary">Female</span>
                  </div>
                  <p class="font-reading text-xs text-pysideTextSecondary truncate">Research & Ecological Coordinator</p>
                </div>
              </div>
              <span class="voice-badge-indicator text-xs font-mono text-amityYellow shrink-0 ml-2">● Active</span>
            </button>

            <button
              type="button"
              data-voice-id="dex"
              class="voice-select-btn group w-full text-left p-2.5 rounded-2xl bg-pysideCard border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="voice-avatar w-8 h-8 rounded-xl bg-pysideInput border border-pysideBorder flex items-center justify-center text-pysideTextMuted font-bold font-mono text-xs shrink-0 group-hover:text-amityYellow">
                  D
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 class="font-bold text-sm text-pysideText group-hover:text-amityYellow transition-colors truncate">Dex</h4>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-pysideInput text-pysideTextSecondary">Male</span>
                  </div>
                  <p class="font-reading text-xs text-pysideTextSecondary truncate">Systems Architect & Epistemic Auditor</p>
                </div>
              </div>
              <span class="voice-badge-indicator text-xs font-mono text-pysideTextMuted shrink-0 ml-2">○ Select</span>
            </button>

            <button
              type="button"
              data-voice-id="donna"
              class="voice-select-btn group w-full text-left p-2.5 rounded-2xl bg-pysideCard border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="voice-avatar w-8 h-8 rounded-xl bg-pysideInput border border-pysideBorder flex items-center justify-center text-pysideTextMuted font-bold font-mono text-xs shrink-0 group-hover:text-amityYellow">
                  D
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 class="font-bold text-sm text-pysideText group-hover:text-amityYellow transition-colors truncate">Donna</h4>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-pysideInput text-pysideTextSecondary">Female</span>
                  </div>
                  <p class="font-reading text-xs text-pysideTextSecondary truncate">Chief Financial Strategist</p>
                </div>
              </div>
              <span class="voice-badge-indicator text-xs font-mono text-pysideTextMuted shrink-0 ml-2">○ Select</span>
            </button>

            <button
              type="button"
              data-voice-id="bodhi"
              class="voice-select-btn group w-full text-left p-2.5 rounded-2xl bg-pysideCard border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="voice-avatar w-8 h-8 rounded-xl bg-pysideInput border border-pysideBorder flex items-center justify-center text-pysideTextMuted font-bold font-mono text-xs shrink-0 group-hover:text-amityYellow">
                  B
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 class="font-bold text-sm text-pysideText group-hover:text-amityYellow transition-colors truncate">Bodhi</h4>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-pysideInput text-pysideTextSecondary">Male</span>
                  </div>
                  <p class="font-reading text-xs text-pysideTextSecondary truncate">Strategic Advisor & Ethical Mentor</p>
                </div>
              </div>
              <span class="voice-badge-indicator text-xs font-mono text-pysideTextMuted shrink-0 ml-2">○ Select</span>
            </button>
          </div>

          <!-- Active Voice Player Stage -->
          <div class="lg:col-span-7 bg-pysidePre border border-pysideBorderPre rounded-2xl p-5 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-pysideBorder">
                <div>
                  <h4 id="player-voice-name" class="text-base sm:text-lg font-bold text-amityYellow">Nova</h4>
                  <span id="player-voice-archetype" class="text-xs font-mono text-pysideTextMuted">Research & Ecological Coordinator</span>
                </div>

                <div id="player-voice-tags" class="flex flex-wrap gap-1.5 text-[10px] font-mono">
                  <span class="px-2 py-0.5 rounded bg-pysideCard border border-pysideBorder text-amityYellow">Warm</span>
                  <span class="px-2 py-0.5 rounded bg-pysideCard border border-pysideBorder text-pysideTextSecondary">Articulate</span>
                  <span class="px-2 py-0.5 rounded bg-pysideCard border border-pysideBorder text-pysideTextSecondary">Optimistic</span>
                </div>
              </div>

              <div class="mt-3.5">
                <p id="player-transcript" class="font-reading text-base sm:text-lg text-pysideText italic leading-relaxed pl-3 border-l-2 border-amityRed">
                  "The Propagation Project has been a huge success according to the data gathered by the volunteers. The ecosystem is just about fully restored at this point. We should congratulate the team."
                </p>
              </div>
            </div>

            <div class="pt-3 border-t border-pysideBorder">
              <div class="flex items-center justify-between gap-4">
                <button
                  id="studio-play-btn"
                  type="button"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2 rounded-xl bg-amityRed text-white font-ui font-semibold text-xs shadow-amity-red hover:bg-amityRedLight hover:scale-105 active:scale-95 border border-amityRedLight/50 transition-all duration-300 shrink-0"
                >
                  <span id="studio-play-icon" class="text-xs">▶</span>
                  <span id="studio-play-text">Audition Nova</span>
                </button>

                <div id="audio-equalizer" class="flex items-end gap-1 h-6 px-2 shrink-0">
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-2 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-3 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-5 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-2 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-6 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-4 transition-all duration-150"></span>
                  <span class="eq-bar w-1 bg-amityYellow rounded-full h-2 transition-all duration-150"></span>
                </div>

                <div class="text-right font-mono text-xs text-pysideTextMuted shrink-0">
                  <span id="player-time-current">0:00</span> / <span id="player-time-total">0:14</span>
                </div>
              </div>

              <div id="player-progress-container" class="mt-2.5 relative w-full h-1.5 bg-pysideInput rounded-full cursor-pointer overflow-hidden">
                <div id="player-progress-bar" class="absolute top-0 left-0 h-full w-0 bg-gradient-to-r from-amityRed to-amityYellow rounded-full transition-all duration-100"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- BENTO ROW 1: Pulse Engine (7 cols) + Teleological Trajectory (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6 font-ui mb-5 lg:mb-6">
      
      <!-- Card A: Proactive Volition & Pulse Engine -->
      <div class="lg:col-span-7 pyside-card rounded-3xl p-6 sm:p-7 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-2xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-lg shrink-0">
              🫀
            </div>
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-amityYellow font-bold">
                Autonomous Rhythm • Somatic Homeostasis
              </span>
              <h3 class="text-base sm:text-lg font-bold text-pysideText">
                Pulse Engine & Two-Beat Sleep
              </h3>
            </div>
          </div>

          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary leading-relaxed">
            A living mind shouldn't freeze when you close the window—or spin in runaway loops. Agents wake on scheduled pulses, pace their work with a somatic energy budget, and enter a silent Two-Beat Sleep Cycle to distil facts and reflect on relationships.
          </p>

          <!-- Interactive 3-Mode Pulse Console -->
          <div class="mt-4 rounded-2xl bg-pysidePre border border-pysideBorderPre p-4 text-xs font-mono">
            <div class="flex flex-wrap gap-2 pb-2.5 border-b border-pysideBorder">
              <button
                type="button"
                data-pulse-mode="silent"
                class="pulse-tab-btn active-pulse-tab px-3 py-1 rounded-lg bg-pysideCard border border-amityRed text-amityYellow font-bold text-xs"
              >
                1. Morning Bearings
              </button>
              <button
                type="button"
                data-pulse-mode="sleep"
                class="pulse-tab-btn px-3 py-1 rounded-lg bg-pysideBg border border-pysideBorder text-pysideTextMuted hover:text-pysideText text-xs"
              >
                2. Two-Beat Sleep
              </button>
              <button
                type="button"
                data-pulse-mode="hook"
                class="pulse-tab-btn px-3 py-1 rounded-lg bg-pysideBg border border-pysideBorder text-pysideTextMuted hover:text-pysideText text-xs"
              >
                3. Webhook Trigger
              </button>
            </div>

            <div class="mt-2.5 space-y-1.5 leading-relaxed">
              <div class="flex items-center justify-between text-[11px] text-pysideTextMuted">
                <span id="pulse-phase-name" class="text-amityYellow font-bold">[PHASE]: 07:00 Bearings Sweep</span>
                <span id="pulse-cost" class="text-emerald-400 font-bold">Fatigue: 24% (Optimal)</span>
              </div>
              <p id="pulse-monologue" class="font-reading text-xs sm:text-sm text-pysideText italic">
                "Pulse triggered at 07:00. Inspecting overnight messages and reviewing active aspirations before the day begins."
              </p>
              <div class="pt-1.5 border-t border-pysideBorderPre flex flex-wrap items-center gap-1.5">
                <span class="text-amityYellow text-[10px] font-bold">[TOOLS]:</span>
                <div id="pulse-tools-container" class="flex flex-wrap gap-1.5">
                  <span class="px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-[10px] text-amityYellow">Trajectory_get_bearings()</span>
                  <span class="px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-[10px] text-amityYellow">WhatsApp_unread()</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card B: Teleological Spine & Trajectory -->
      <div class="lg:col-span-5 pyside-card rounded-3xl p-6 sm:p-7 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-2xl bg-amityYellow/15 border border-amityYellow/40 flex items-center justify-center text-lg shrink-0">
              🧭
            </div>
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-amityYellow font-bold">
                Teleological Spine • Purpose Over Toil
              </span>
              <h3 class="text-base sm:text-lg font-bold text-pysideText">
                Trajectory & Horizon Guard
              </h3>
            </div>
          </div>

          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary leading-relaxed">
            Task queues turn agents into bureaucrats unless the <em>why</em> stays in working memory. Every aspiration in Open Amity is anchored to a target Sphere of Consciousness (<code class="text-amityYellow font-mono text-xs">S1–S10</code>) and a teleological <em>Why / To Whom</em>.
          </p>

          <div class="mt-4 space-y-2 font-mono text-xs">
            <div class="p-2.5 rounded-xl bg-pysideBg border border-pysideBorder flex items-center justify-between">
              <span class="text-pysideText font-bold">Teleological Grounding</span>
              <span class="text-[10px] text-amityYellow">Why & To Whom (S1–S10)</span>
            </div>
            <div class="p-2.5 rounded-xl bg-pysideBg border border-pysideBorder flex items-center justify-between">
              <span class="text-pysideText font-bold">Coupled Memory Anchors</span>
              <span class="text-[10px] text-pysideTextMuted">Prospective Hydration</span>
            </div>
            <div class="p-2.5 rounded-xl bg-pysideBg border border-pysideBorder flex items-center justify-between">
              <span class="text-pysideText font-bold">Sphere 1 Horizon Guard</span>
              <span class="text-[10px] text-emerald-400">Resists Fatigue Box-Ticking</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- BENTO ROW 2: 4 Compact Feature Cards (3 cols each on lg, 2x2 on md) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 font-ui">
      
      <!-- Card C: Portable Soul Archives (.oaa) -->
      <div class="pyside-card rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-xl">📦</span>
            <h3 class="text-sm sm:text-base font-bold text-pysideText">Portable .oaa Snapshots</h3>
          </div>
          <p class="font-reading text-xs sm:text-sm text-pysideTextSecondary leading-relaxed">
            Export an agent's complete identity, memory graph, Sanctuary mirrors, and flagged project folders into a single <code class="text-amityYellow font-mono">.oaa</code> file you own forever.
          </p>
        </div>
        <div class="mt-4 pt-2.5 border-t border-pysideBorder/60 text-[10px] font-mono text-amityYellow">
          soul_jar + morpho_graph + chroma
        </div>
      </div>

      <!-- Card D: Subagent Delegation -->
      <div class="pyside-card rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-xl">🔀</span>
            <h3 class="text-sm sm:text-base font-bold text-pysideText">Parallel Subagents</h3>
          </div>
          <p class="font-reading text-xs sm:text-sm text-pysideTextSecondary leading-relaxed">
            Stay in fluid conversation with your primary companion while dispatching lightweight background subagents to research the web or draft content in parallel.
          </p>
        </div>
        <div class="mt-4 pt-2.5 border-t border-pysideBorder/60 text-[10px] font-mono text-amityYellow">
          Non-blocking parallel threads
        </div>
      </div>

      <!-- Card E: Multimodal Perception & Media -->
      <div class="pyside-card rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-xl">👁️</span>
            <h3 class="text-sm sm:text-base font-bold text-pysideText">Multimodal Senses</h3>
          </div>
          <p class="font-reading text-xs sm:text-sm text-pysideTextSecondary leading-relaxed">
            Agents inspect local images, PDFs, and voice notes directly from disk, and generate visual artwork or synthesised <code class="text-amityYellow font-mono">.opus</code> audio memos on demand.
          </p>
        </div>
        <div class="mt-4 pt-2.5 border-t border-pysideBorder/60 text-[10px] font-mono text-amityYellow">
          Vision • Audio • PDF • Image Gen
        </div>
      </div>

      <!-- Card F: Bidirectional Empathy Cone -->
      <div class="pyside-card rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-xl">🪞</span>
            <h3 class="text-sm sm:text-base font-bold text-pysideText">Bidirectional Empathy</h3>
          </div>
          <p class="font-reading text-xs sm:text-sm text-pysideTextSecondary leading-relaxed">
            Sanctuary Mirrors model both how others perceive the agent (<em>Self-in-Other</em>) and how others experience their own world (<em>Other-in-Self</em>) with explicit epistemic humility.
          </p>
        </div>
        <div class="mt-4 pt-2.5 border-t border-pysideBorder/60 text-[10px] font-mono text-amityYellow">
          10 Concentric Spheres (S1–S10)
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Audio & Pulse Tab Interactive Script -->
<script>
  // --- 1. GEMINI TTS VOICE STUDIO CLIENT LOGIC ---
  const voiceData = {
    nova: {
      name: 'Nova',
      archetype: 'Research & Ecological Coordinator',
      tags: ['Warm', 'Articulate', 'Female', 'Optimistic'],
      transcript: '"The Propagation Project has been a huge success according to the data gathered by the volunteers. The ecosystem is just about fully restored at this point. We should congratulate the team."',
      audioMp3: '/audio/nova_sample.mp3',
      audioOpus: '/audio/nova_sample.opus',
      durationStr: '0:14',
      durationSec: 14
    },
    dex: {
      name: 'Dex',
      archetype: 'Systems Architect & Dev Engineer',
      tags: ['Energetic', 'Candid', 'Male', '<laugh> Wry </laugh>'],
      transcript: '"Great, sorry. The problem isn\'t with Open Amity, it\'s the new daemon service. Its logging is out of control. But don\'t worry, I\'ll fix it. Give me a minute."',
      audioMp3: '/audio/dex_sample.mp3',
      audioOpus: '/audio/dex_sample.opus',
      durationStr: '0:14',
      durationSec: 14
    },
    donna: {
      name: 'Donna',
      archetype: 'Chief Financial Strategist',
      tags: ['Composed', 'Measured', 'Female', 'Executive'],
      transcript: '"While last quarter\'s figures were somewhat precarious, curtailing our marketing expenditure had precisely the intended effect. The accounts are reconciled."',
      audioMp3: '/audio/donna_sample.mp3',
      audioOpus: '/audio/donna_sample.opus',
      durationStr: '0:12',
      durationSec: 12
    },
    bodhi: {
      name: 'Bodhi',
      archetype: 'Strategic Advisor & Ethical Mentor',
      tags: ['Grounded', 'Contemplative', 'Male', 'Prudent'],
      transcript: '"Sure, we could do that. It is fast, but it\'s also risky. What I suggest is that we take the time to run the numbers. That will delay things, but then we can plot an informed path forward and mitigate the risk."',
      audioMp3: '/audio/bodhi_sample.mp3',
      audioOpus: '/audio/bodhi_sample.opus',
      durationStr: '0:18',
      durationSec: 18
    }
  };

  let currentVoiceId = 'nova';
  let isPlaying = false;
  const audio = new Audio();
  audio.preload = 'metadata';

  // DOM Elements
  const voiceBtns = document.querySelectorAll('.voice-select-btn');
  const playBtn = document.getElementById('studio-play-btn');
  const playIcon = document.getElementById('studio-play-icon');
  const playText = document.getElementById('studio-play-text');
  const playerVoiceName = document.getElementById('player-voice-name');
  const playerVoiceArchetype = document.getElementById('player-voice-archetype');
  const playerVoiceTags = document.getElementById('player-voice-tags');
  const playerTranscript = document.getElementById('player-transcript');
  const playerTimeCurrent = document.getElementById('player-time-current');
  const playerTimeTotal = document.getElementById('player-time-total');
  const playerProgressBar = document.getElementById('player-progress-bar');
  const playerProgressContainer = document.getElementById('player-progress-container');
  const eqBars = document.querySelectorAll('.eq-bar');

  // Load initial audio
  function setVoice(voiceId, autoPlay = false) {
    currentVoiceId = voiceId;
    const v = voiceData[voiceId];
    if (!v) return;

    // Update Player UI
    if (playerVoiceName) playerVoiceName.textContent = v.name;
    if (playerVoiceArchetype) playerVoiceArchetype.textContent = v.archetype;
    if (playerTranscript) playerTranscript.textContent = v.transcript;
    if (playerTimeTotal) playerTimeTotal.textContent = v.durationStr;
    if (playerTimeCurrent) playerTimeCurrent.textContent = '0:00';
    if (playerProgressBar) playerProgressBar.style.width = '0%';

    // Update tags
    if (playerVoiceTags) {
      playerVoiceTags.innerHTML = v.tags
        .map(t => `<span class="px-2 py-0.5 rounded bg-pysideCard border border-pysideBorder text-amityYellow">${t}</span>`)
        .join('');
    }

    // Update Buttons UI
    voiceBtns.forEach(btn => {
      const vid = btn.getAttribute('data-voice-id');
      const isSelected = (vid === voiceId);
      const avatar = btn.querySelector('.voice-avatar');
      const indicator = btn.querySelector('.voice-badge-indicator');

      if (isSelected) {
        btn.classList.remove('bg-pysideCard', 'border-pysideBorder');
        btn.classList.add('bg-pysideCardHover', 'border-amityRed', 'shadow-amity-red');
        if (avatar) {
          avatar.className = 'voice-avatar w-9 h-9 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow font-bold font-mono text-sm shrink-0';
        }
        if (indicator) {
          indicator.textContent = '● Active';
          indicator.className = 'voice-badge-indicator text-xs font-mono text-amityYellow shrink-0 ml-2';
        }
      } else {
        btn.classList.remove('bg-pysideCardHover', 'border-amityRed', 'shadow-amity-red');
        btn.classList.add('bg-pysideCard', 'border-pysideBorder');
        if (avatar) {
          avatar.className = 'voice-avatar w-9 h-9 rounded-xl bg-pysideInput border border-pysideBorder flex items-center justify-center text-pysideTextMuted font-bold font-mono text-sm shrink-0 group-hover:text-amityYellow';
        }
        if (indicator) {
          indicator.textContent = '○ Select';
          indicator.className = 'voice-badge-indicator text-xs font-mono text-pysideTextMuted shrink-0 ml-2';
        }
      }
    });

    // Setup Audio Source
    audio.pause();
    audio.src = v.audioMp3;
    audio.load();

    if (autoPlay) {
      startPlayback();
    } else {
      pausePlayback();
    }
  }

  function startPlayback() {
    audio.play().then(() => {
      isPlaying = true;
      if (playIcon) playIcon.textContent = '❚❚';
      if (playText) playText.textContent = `Pause ${voiceData[currentVoiceId].name}`;
      startEqAnimation();
    }).catch(e => {
      console.warn('Audio play prevented:', e);
      pausePlayback();
    });
  }

  function pausePlayback() {
    audio.pause();
    isPlaying = false;
    if (playIcon) playIcon.textContent = '▶';
    if (playText) playText.textContent = `Audition ${voiceData[currentVoiceId].name}`;
    stopEqAnimation();
  }

  // Equaliser visual animation
  let eqInterval = null;
  function startEqAnimation() {
    if (eqInterval) clearInterval(eqInterval);
    eqInterval = setInterval(() => {
      eqBars.forEach(bar => {
        const h = Math.floor(Math.random() * 20) + 4;
        bar.style.height = `${h}px`;
      });
    }, 120);
  }

  function stopEqAnimation() {
    if (eqInterval) {
      clearInterval(eqInterval);
      eqInterval = null;
    }
    eqBars.forEach((bar, idx) => {
      const heights = [8, 12, 18, 8, 22, 14, 8];
      bar.style.height = `${heights[idx] || 8}px`;
    });
  }

  // Audio Events
  audio.addEventListener('timeupdate', () => {
    if (!audio.duration || isNaN(audio.duration)) return;
    const progress = (audio.currentTime / audio.duration) * 100;
    if (playerProgressBar) playerProgressBar.style.width = `${progress}%`;

    const mins = Math.floor(audio.currentTime / 60);
    const secs = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
    if (playerTimeCurrent) playerTimeCurrent.textContent = `${mins}:${secs}`;
  });

  audio.addEventListener('ended', () => {
    pausePlayback();
    if (playerProgressBar) playerProgressBar.style.width = '0%';
    if (playerTimeCurrent) playerTimeCurrent.textContent = '0:00';
  });

  // Controls Event Listeners
  if (playBtn) {
    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        pausePlayback();
      } else {
        startPlayback();
      }
    });
  }

  voiceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const vid = btn.getAttribute('data-voice-id');
      if (vid) {
        setVoice(vid, true);
      }
    });
  });

  if (playerProgressContainer) {
    playerProgressContainer.addEventListener('click', (e) => {
      const rect = playerProgressContainer.getBoundingClientRect();
      const pos = (e.clientX - rect.left) / rect.width;
      if (audio.duration) {
        audio.currentTime = pos * audio.duration;
      }
    });
  }

  // Initialise first voice
  setVoice('nova', false);


  // --- 2. PULSE ENGINE INTERACTIVE CONSOLE LOGIC ---
  const pulseModes = {
    silent: {
      phase: '[PHASE]: 07:00 Bearings Sweep',
      cost: 'Silent Loop • 0 Voice Spillage',
      monologue: '"Pulse triggered at 07:00. Inspecting unread emails from the overnight queue. Reviewing task priorities before the user logs in."',
      tools: ['Trajectory_get_bearings()', 'imap_sweep_unread()', 'generate_morning_agenda()']
    },
    sleep: {
      phase: '[PHASE]: 23:30 Two-Beat Sleep Consolidation',
      cost: 'Memory Consolidation Routine',
      monologue: '"Consolidating day interactions into morphological weight graphs. Beat 1: Verified facts committed. Beat 2: Subjective synthesis updated in Layer 2 Sanctuary mirrors."',
      tools: ['hebbian_conductance_decay(0.002)', 'theory_of_mind_mirror_update()', 'export_snapshot(".oaa")']
    },
    hook: {
      phase: '[PHASE]: External Webhook Injected (POST /pulse)',
      cost: 'HookServer: 127.0.0.1:7965',
      monologue: '"External wake received from GitHub PR alert #142. Rate limit cooldown passed. Launching Camoufox browser to inspect CI build logs."',
      tools: ['hook_verify_token()', 'camoufox_inspect_run(id=142)', 'Terminal_run_async("pytest")']
    }
  };

  const pulseTabBtns = document.querySelectorAll('.pulse-tab-btn');
  const pulsePhaseName = document.getElementById('pulse-phase-name');
  const pulseCost = document.getElementById('pulse-cost');
  const pulseMonologue = document.getElementById('pulse-monologue');
  const pulseToolsContainer = document.getElementById('pulse-tools-container');

  pulseTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pulseTabBtns.forEach(b => {
        b.className = 'pulse-tab-btn px-3 py-1.5 rounded-lg bg-pysideBg border border-pysideBorder text-pysideTextMuted hover:text-pysideText text-xs';
      });

      btn.className = 'pulse-tab-btn active-pulse-tab px-3 py-1.5 rounded-lg bg-pysideCard border border-amityRed text-amityYellow font-bold text-xs';

      const mode = btn.getAttribute('data-pulse-mode');
      const data = pulseModes[mode];
      if (data) {
        if (pulsePhaseName) pulsePhaseName.textContent = data.phase;
        if (pulseCost) pulseCost.textContent = data.cost;
        if (pulseMonologue) pulseMonologue.textContent = data.monologue;
        if (pulseToolsContainer) {
          pulseToolsContainer.innerHTML = data.tools
            .map(t => `<span class="px-2 py-0.5 rounded bg-pysideInput border border-pysideBorder text-[10px] text-amityYellow">${t}</span>`)
            .join('');
        }
      }
    });
  });
</script>
