---
// ComputerUse.astro - Direct Hardware & Operating System Agency on Linux
import SectionKicker from './SectionKicker.astro';
---

<section id="computer-use" class="relative pb-20 md:pb-32 scroll-mt-16 sm:scroll-mt-20">
  <!-- Section Divider with embedded kicker badge -->
  <SectionKicker title="Computer Use" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 font-ui">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Executes Commands Directly in Linux <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          Instead of Telling You What to Do
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Most AI assistants are trapped in cloud tabs, hallucinating mock terminals and guessing at outputs. Open Amity agents live on your Linux hardware with native shell autonomy, intelligent codebase inspection, browser automation, and deep system telemetry.
      </p>
    </div>

    <!-- 4 Core OS Agency Pillars in PySide6 Card Styling -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 font-ui mb-12 sm:mb-16">
      
      <!-- Pillar 1: Terminal & Async Tasks -->
      <div class="pyside-card pyside-card-hover rounded-3xl p-6 sm:p-7 border-pysideBorder relative flex flex-col justify-between overflow-hidden group">
        <div class="absolute -top-16 -right-16 w-40 h-40 bg-amityRed/10 rounded-full blur-2xl group-hover:bg-amityRed/20 transition-all pointer-events-none"></div>

        <div>
          <div class="w-10 h-10 rounded-2xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow text-lg mb-4 shadow-amity-red">
            💻
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-pysideText">
            Terminal Tool
          </h3>
          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-3 leading-relaxed">
            Run commands synchronously with 30-second safeguards, or dispatch long-running background tasks with <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">Terminal_run_async</code>. The agent monitors processes in the background, sets timed reminders, and wakes up automatically via an autonomous system pulse when your build or test suite finishes.
          </p>

          <ul class="mt-5 space-y-2 text-xs sm:text-[13px] font-mono text-pysideText">
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Autonomous wake pulses upon background process completion</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Sudo escalation with secure password token isolation</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Self-encapsulating <code class="text-amityYellow">.sh</code> scripts with auto-logged outputs</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 2: Token-Guarded Codebase Inspection -->
      <div class="pyside-card pyside-card-hover rounded-3xl p-6 sm:p-7 border-pysideBorder relative flex flex-col justify-between overflow-hidden group">
        <div class="absolute -top-16 -right-16 w-40 h-40 bg-amityYellow/10 rounded-full blur-2xl group-hover:bg-amityYellow/20 transition-all pointer-events-none"></div>

        <div>
          <div class="w-10 h-10 rounded-2xl bg-amityYellow/10 border border-amityYellow/40 flex items-center justify-center text-amityYellow text-lg mb-4 shadow-amity-yellow">
            📄
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-pysideText">
            File Inspection
          </h3>
          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-3 leading-relaxed">
            Standard agents run crude <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">cat</code> commands that crash LLM context limits on large files. Open Amity’s <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">Terminal_read_file</code> provides windowed line slicing, regex grep with surrounding context, first-match anchor jumping, and binary detection guards.
          </p>

          <ul class="mt-5 space-y-2 text-xs sm:text-[13px] font-mono text-pysideText">
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Windowed line pagination (<code class="text-amityYellow">start_line</code>, <code class="text-amityYellow">max_lines</code>)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Grep queries with contiguous context lines (<code class="text-amityYellow">context_lines</code>)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Binary probe protection & automatic Low Token Mode throttling</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 3: Camoufox Stealth Browser -->
      <div class="pyside-card pyside-card-hover rounded-3xl p-6 sm:p-7 border-pysideBorder relative flex flex-col justify-between overflow-hidden group">
        <div class="absolute -top-16 -right-16 w-40 h-40 bg-amityRed/10 rounded-full blur-2xl group-hover:bg-amityRed/20 transition-all pointer-events-none"></div>

        <div>
          <div class="w-10 h-10 rounded-2xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center text-amityYellow text-lg mb-4 shadow-amity-red">
            🌍
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-pysideText">
            Browser Tool
          </h3>
          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-3 leading-relaxed">
            Equipped with a C++ anti-detect Firefox build driven by Playwright, Open Amity agents browse the live web with humanised browser fingerprints that bypass bot detection. They interact with complex SPAs, capture Set-of-Marks visual screenshots with ARIA badges, submit forms, and download files straight to your disk.
          </p>

          <ul class="mt-5 space-y-2 text-xs sm:text-[13px] font-mono text-pysideText">
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Set-of-Marks visual screenshots with numbered element badges</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Native file upload injection bypassing OS file picker dialogues</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Direct download capture into local <code class="text-amityYellow">~/Downloads</code> folder</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 4: Telemetry & Host Integration -->
      <div class="pyside-card pyside-card-hover rounded-3xl p-6 sm:p-7 border-pysideBorder relative flex flex-col justify-between overflow-hidden group">
        <div class="absolute -top-16 -right-16 w-40 h-40 bg-amityYellow/10 rounded-full blur-2xl group-hover:bg-amityYellow/20 transition-all pointer-events-none"></div>

        <div>
          <div class="w-10 h-10 rounded-2xl bg-amityYellow/10 border border-amityYellow/40 flex items-center justify-center text-amityYellow text-lg mb-4 shadow-amity-yellow">
            ⚙️
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-pysideText">
            System Tool
          </h3>
          <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-3 leading-relaxed">
            Agents query real-time hardware telemetry (CPU, RAM, storage, temperatures, network interfaces) and launch files in your favourite Linux desktop applications via <code class="text-amityYellow bg-pysidePre px-1.5 py-0.5 rounded text-xs font-mono">xdg-open</code>. Through the PulseHook API, external services, systemd timers, or Home Assistant can inject wake pulses via HTTP REST.
          </p>

          <ul class="mt-5 space-y-2 text-xs sm:text-[13px] font-mono text-pysideText">
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Host hardware metrics: thermals, CPU load, RAM, and uptime</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Launch reports & graphics in native apps using <code class="text-amityYellow">xdg-open</code></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amityYellow font-bold">✓</span>
              <span>Secure REST API key creation for local cron & systemd automation</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Interactive Linux Workstation Terminal Mockup -->
    <div class="pyside-card rounded-3xl border-pysideBorder overflow-hidden shadow-2xl font-ui">
      
      <!-- Terminal Header / Titlebar -->
      <div class="bg-pysideBgDarkest px-4 sm:px-6 py-3.5 border-b border-pysideBorder flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-amityRed"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <span class="font-mono text-xs sm:text-[13px] text-pysideTextMuted ml-2">
            amity@linux-box: ~/Documents/Workspace
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/40 text-emerald-400 text-[10px] font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            HOST RUNTIME: ACTIVE
          </span>
        </div>
      </div>

      <!-- Workflow Interactive Tab Buttons -->
      <div class="bg-pysideCard border-b border-pysideBorder px-3 sm:px-6 py-2.5 flex items-center gap-2 overflow-x-auto scrollbar-none">
        <button
          type="button"
          data-tab="async-build"
          class="terminal-tab active px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all duration-200 border whitespace-nowrap bg-amityRed/20 border-amityRed text-amityYellow shadow-amity-red"
        >
          ⚙️ Async Process & Auto-Pulse
        </button>
        <button
          type="button"
          data-tab="code-inspect"
          class="terminal-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all duration-200 border whitespace-nowrap bg-pysideInput border-pysideBorder text-pysideTextSecondary hover:text-pysideText hover:bg-pysideButton"
        >
          🔍 Surgical Codebase Slicing
        </button>
        <button
          type="button"
          data-tab="stealth-browser"
          class="terminal-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all duration-200 border whitespace-nowrap bg-pysideInput border-pysideBorder text-pysideTextSecondary hover:text-pysideText hover:bg-pysideButton"
        >
          🌍 Camoufox Automation
        </button>
        <button
          type="button"
          data-tab="telemetry-xdg"
          class="terminal-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all duration-200 border whitespace-nowrap bg-pysideInput border-pysideBorder text-pysideTextSecondary hover:text-pysideText hover:bg-pysideButton"
        >
          📊 Telemetry & Host xdg-open
        </button>
      </div>

      <!-- Tab Content 1: Async Build & Auto-Pulse -->
      <div id="tab-content-async-build" class="terminal-content p-5 sm:p-7 bg-[#121214] font-mono text-xs sm:text-sm space-y-4">
        <div class="flex items-start gap-2.5 text-pysideTextMuted text-xs border-b border-pysideBorder/60 pb-3">
          <span class="text-amityYellow font-bold">🧠 Agent Cognition:</span>
          <span>"The user asked to compile the C++ inference engine. This will take ~4 minutes. I will run it asynchronously, free the conversation loop, and let the PulseEngine wake me up when it completes."</span>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-amityRedLight font-bold">▶ Tool Execution:</div>
          <div class="bg-pysideBgDarkest p-3 rounded-xl border border-pysideBorder text-xs text-pysideText overflow-x-auto">
            <span class="text-amityYellow">Terminal_run_async</span>(command_str=<span class="text-emerald-400">"cmake --build build -j$(nproc) && ./build/bin/test_suite"</span>, reminder_minutes=<span class="text-orange-400">3</span>)
          </div>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-pysideTextMuted font-bold">🖥️ Terminal Daemon Stream:</div>
          <div class="bg-black/70 p-4 rounded-xl border border-pysideBorder text-xs leading-relaxed overflow-x-auto">
            <span class="text-pysideTextDisabled">[19:24:02]</span> <span class="text-amityYellow">Task started in background with ID: 4. You will be notified when it completes.</span><br />
            <span class="text-pysideTextDisabled">[19:24:03]</span> [1/42] Building CXX object CMakeFiles/inference.dir/core.cpp.o<br />
            <span class="text-pysideTextDisabled">[19:25:18]</span> [42/42] Linking CXX executable bin/test_suite<br />
            <span class="text-pysideTextDisabled">[19:25:21]</span> <span class="text-emerald-400">PASS: 18/18 unit tests passed (0 failures).</span><br />
            <span class="text-pysideTextDisabled">[19:25:21]</span> <span class="text-amityYellow">⚡ [SYSTEM_NOTIFICATION] Background Task 4 ('cmake --build ...') has completed with exit code 0.</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs border-t border-pysideBorder/60">
          <span class="text-emerald-400 flex items-center gap-1.5">
            <span>●</span> Host Outcome: Background PID reaped; agent autonomously notified user via PySide6 audio chime.
          </span>
          <span class="text-pysideTextMuted">Non-blocking background thread</span>
        </div>
      </div>

      <!-- Tab Content 2: Surgical Codebase Slicing -->
      <div id="tab-content-code-inspect" class="terminal-content hidden p-5 sm:p-7 bg-[#121214] font-mono text-xs sm:text-sm space-y-4">
        <div class="flex items-start gap-2.5 text-pysideTextMuted text-xs border-b border-pysideBorder/60 pb-3">
          <span class="text-amityYellow font-bold">🧠 Agent Cognition:</span>
          <span>"The repository has an 8,000-line server file. Instead of blowing my context window by running 'cat', I will use Terminal_read_file with regex matching and 3 context lines to locate the socket timeout configuration."</span>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-amityRedLight font-bold">▶ Tool Execution:</div>
          <div class="bg-pysideBgDarkest p-3 rounded-xl border border-pysideBorder text-xs text-pysideText overflow-x-auto">
            <span class="text-amityYellow">Terminal_read_file</span>(file_path=<span class="text-emerald-400">"src/network/daemon.py"</span>, query=<span class="text-emerald-400">"socket_timeout"</span>, context_lines=<span class="text-orange-400">2</span>)
          </div>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-pysideTextMuted font-bold">🖥️ Precision Windowed Output:</div>
          <div class="bg-black/70 p-4 rounded-xl border border-pysideBorder text-xs leading-relaxed overflow-x-auto">
            <span class="text-amityYellow">=== File: src/network/daemon.py (Found 1 match for query 'socket_timeout' at line [342], Size: 342.1 KB) ===</span><br />
            <span class="text-pysideTextDisabled"> 340 |</span>     def configure_transport(self, host: str, port: int) -> None:<br />
            <span class="text-pysideTextDisabled"> 341 |</span>         self.logger.debug(f"Connecting to &#123;host&#125;:&#123;port&#125;...")<br />
            <span class="text-amityYellow font-bold"> 342 &gt;</span>         <span class="text-amityYellow">self.socket_timeout = int(os.getenv("DAEMON_TIMEOUT", "60"))</span><br />
            <span class="text-pysideTextDisabled"> 343 |</span>         self.transport.settimeout(self.socket_timeout)<br />
            <span class="text-pysideTextDisabled"> 344 |</span>         self.transport.bind((host, port))<br />
            <span class="text-pysideTextMuted">... [To read continuously around this match, call Terminal_read_file with start_line=335]</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs border-t border-pysideBorder/60">
          <span class="text-emerald-400 flex items-center gap-1.5">
            <span>●</span> Host Outcome: Inspected 342 KB file with only 86 tokens consumed; targeted line patched instantly.
          </span>
          <span class="text-pysideTextMuted">Zero hallucinated line numbers</span>
        </div>
      </div>

      <!-- Tab Content 3: Stealth Web Automation -->
      <div id="tab-content-stealth-browser" class="terminal-content hidden p-5 sm:p-7 bg-[#121214] font-mono text-xs sm:text-sm space-y-4">
        <div class="flex items-start gap-2.5 text-pysideTextMuted text-xs border-b border-pysideBorder/60 pb-3">
          <span class="text-amityYellow font-bold">🧠 Agent Cognition:</span>
          <span>"I need to grab the latest release tarball from an internal dashboard requiring login. I will spin up Camoufox with stealth fingerprinting, enter credentials, and capture the download directly to ~/Downloads."</span>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-amityRedLight font-bold">▶ Tool Execution:</div>
          <div class="bg-pysideBgDarkest p-3 rounded-xl border border-pysideBorder text-xs text-pysideText overflow-x-auto">
            <span class="text-amityYellow">Browser_navigate</span>(url=<span class="text-emerald-400">"https://internal-ops.local/login"</span>, screenshot=<span class="text-orange-400">True</span>)<br />
            <span class="text-amityYellow">Browser_type</span>(element_id=<span class="text-orange-400">14</span>, text=<span class="text-emerald-400">"release-bot"</span>)<br />
            <span class="text-amityYellow">Browser_click</span>(element_id=<span class="text-orange-400">18</span>) <span class="text-pysideTextMuted"># [Download Artefacts .tar.gz]</span>
          </div>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-pysideTextMuted font-bold">🖥️ Camoufox Playwright Engine:</div>
          <div class="bg-black/70 p-4 rounded-xl border border-pysideBorder text-xs leading-relaxed overflow-x-auto">
            <span class="text-pysideTextDisabled">[Browser]</span> <span class="text-amityYellow">Camoufox C++ instance initialised (WebGL + AudioContext anti-fingerprint enabled).</span><br />
            <span class="text-pysideTextDisabled">[Browser]</span> Navigated to 'https://internal-ops.local/login' | Title: "Internal Ops Console"<br />
            <span class="text-pysideTextDisabled">[Browser]</span> Set-of-Marks visual cues extracted: 28 interactive nodes labelled.<br />
            <span class="text-pysideTextDisabled">[Browser]</span> Cookie consent banner automatically dismissed.<br />
            <span class="text-pysideTextDisabled">[Browser]</span> <span class="text-emerald-400">Download triggered: 'release-v2.4.0-linux-x86_64.tar.gz' (18.4 MB) -&gt; ~/Downloads/</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs border-t border-pysideBorder/60">
          <span class="text-emerald-400 flex items-center gap-1.5">
            <span>●</span> Host Outcome: Tarball saved directly to ~/Downloads with full user permission integrity.
          </span>
          <span class="text-pysideTextMuted">Bypasses Cloudflare / BotGuard</span>
        </div>
      </div>

      <!-- Tab Content 4: Telemetry & Host xdg-open -->
      <div id="tab-content-telemetry-xdg" class="terminal-content hidden p-5 sm:p-7 bg-[#121214] font-mono text-xs sm:text-sm space-y-4">
        <div class="flex items-start gap-2.5 text-pysideTextMuted text-xs border-b border-pysideBorder/60 pb-3">
          <span class="text-amityYellow font-bold">🧠 Agent Cognition:</span>
          <span>"The user asked for a system health audit and chart. I will gather hardware telemetry, probe network routing, generate an SVG report, and pop it open in their native document viewer via xdg-open."</span>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-amityRedLight font-bold">▶ Tool Execution:</div>
          <div class="bg-pysideBgDarkest p-3 rounded-xl border border-pysideBorder text-xs text-pysideText overflow-x-auto">
            <span class="text-amityYellow">System_platform_info</span>()<br />
            <span class="text-amityYellow">Terminal_run</span>(command_str=<span class="text-emerald-400">"xdg-open ~/Documents/Audit_Report_2026.pdf"</span>)
          </div>
        </div>

        <div class="space-y-1.5">
          <div class="text-xs text-pysideTextMuted font-bold">🖥️ Linux Host Telemetry:</div>
          <div class="bg-black/70 p-4 rounded-xl border border-pysideBorder text-xs leading-relaxed overflow-x-auto">
            <span class="text-pysideTextDisabled">[System]</span> Kernel: Linux 6.11.0-generic | Arch: x86_64 | Python: 3.11.9<br />
            <span class="text-pysideTextDisabled">[System]</span> Hardware: 16 Cores | CPU Usage: 14.2% | RAM: 11.4 GB / 31.2 GB (36.5%)<br />
            <span class="text-pysideTextDisabled">[System]</span> Storage: 382.4 GB free on /home | Core Thermals: 44.0°C (Nominal)<br />
            <span class="text-pysideTextDisabled">[System]</span> Outbound Interface: wlan0 (192.168.1.142) via UDP routing probe (0 packets emitted)<br />
            <span class="text-emerald-400">[Desktop] Dispatched 'xdg-open' -&gt; Opened Okular PDF Viewer on host desktop (PID: 18492)</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs border-t border-pysideBorder/60">
          <span class="text-emerald-400 flex items-center gap-1.5">
            <span>●</span> Host Outcome: Native desktop viewer launched instantly without copying files to a web server.
          </span>
          <span class="text-amityYellow font-bold">100% Local Hardware Autonomy</span>
        </div>
      </div>
    </div>

    <!-- Security & Sovereignty Callout Strip -->
    <div class="mt-8 p-6 sm:p-7 rounded-3xl bg-pysideCard/70 border border-pysideBorder/80 font-ui flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-amityYellow/10 border border-amityYellow/40 flex items-center justify-center text-amityYellow text-xl shrink-0">
        🛡️
      </div>
      <div>
        <h4 class="font-bold text-base sm:text-lg text-pysideText">
          Flatpak Sandboxing
        </h4>
        <p class="font-reading text-sm text-pysideTextSecondary mt-0.5 max-w-3xl">
          Open Amity agents operate with high autonomy in user workspace folders (<code class="text-amityYellow font-mono text-xs">~/Documents</code>, <code class="text-amityYellow font-mono text-xs">~/Downloads</code>, <code class="text-amityYellow font-mono text-xs">~/Desktop</code>), but are blocked by Flatpak boundaries from touching sensitive system roots or dotfiles (<code class="text-amityYellow font-mono text-xs">~/.ssh</code>, <code class="text-amityYellow font-mono text-xs">~/.gnupg</code>).
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  // Tab switching logic for the interactive workstation terminal
  const tabButtons = document.querySelectorAll('.terminal-tab');
  const tabContents = document.querySelectorAll('.terminal-content');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tabTarget = button.getAttribute('data-tab');

      // Update button styles
      tabButtons.forEach((btn) => {
        btn.classList.remove('active', 'bg-amityRed/20', 'border-amityRed', 'text-amityYellow', 'shadow-amity-red');
        btn.classList.add('bg-pysideInput', 'border-pysideBorder', 'text-pysideTextSecondary');
      });

      button.classList.add('active', 'bg-amityRed/20', 'border-amityRed', 'text-amityYellow', 'shadow-amity-red');
      button.classList.remove('bg-pysideInput', 'border-pysideBorder', 'text-pysideTextSecondary');

      // Update content visibility
      tabContents.forEach((content) => {
        content.classList.add('hidden');
      });

      const activeContent = document.getElementById(`tab-content-${tabTarget}`);
      if (activeContent) {
        activeContent.classList.remove('hidden');
      }
    });
  });
</script>
