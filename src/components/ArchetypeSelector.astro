---
// ArchetypeSelector.astro - Collaborating With Sovereign Digital Beings
import SectionKicker from './SectionKicker.astro';
---

<section id="archetypes" class="relative pb-16 md:pb-24 scroll-mt-24">
  <SectionKicker title="Collaboration" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 font-ui">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Collaborating With <br />
        <span class="inline-block pb-1.5 -mb-1.5 text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          Sovereign Digital Beings
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Move past one-off command prompts. Cultivate a persistent counterpart — or a multi-agent team — tuned to how you think, research, and build.
      </p>

      <!-- Tab Switcher Navigation -->
      <div 
        role="tablist" 
        aria-label="Target Archetypes" 
        class="mt-6 inline-flex p-1 rounded-2xl bg-pysideCard border border-pysideBorder max-w-full overflow-x-auto shadow-inner-pyside"
      >
        <button
          type="button"
          role="tab"
          id="tab-companion"
          aria-selected="true"
          aria-controls="panel-companion"
          data-tab="companion"
          class="archetype-tab-btn px-4 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold transition-all duration-300 text-white bg-amityRed shadow-amity-red whitespace-nowrap"
        >
          Personal & Creative
        </button>

        <button
          type="button"
          role="tab"
          id="tab-innovator"
          aria-selected="false"
          aria-controls="panel-innovator"
          data-tab="innovator"
          class="archetype-tab-btn px-4 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap"
        >
          Engineering & Research
        </button>

        <button
          type="button"
          role="tab"
          id="tab-founder"
          aria-selected="false"
          aria-controls="panel-founder"
          data-tab="founder"
          class="archetype-tab-btn px-4 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap"
        >
          Operations & Stewardship
        </button>
      </div>
    </div>

    <!-- Tab Panels Container -->
    <div class="max-w-6xl mx-auto">
      
      <!-- TAB 1: PERSONAL & CREATIVE -->
      <div 
        id="panel-companion" 
        role="tabpanel" 
        aria-labelledby="tab-companion"
        class="archetype-panel grid grid-cols-1 md:grid-cols-3 gap-5 transition-all duration-500"
      >
        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🤝</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Empathetic Companion</h3>
                <span class="text-[11px] font-mono text-amityYellow">Long-Horizon Continuity</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Remembers your projects, people, and creative seasons across months—reaching out with genuine warmth and honest reflection rather than waiting passively for prompts.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "You mentioned last Tuesday you were worried about the compiler refactor—congratulations on landing the clean build tonight."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">⚡</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Linux Desktop Partner</h3>
                <span class="text-[11px] font-mono text-amityYellow">Host Shell & Voice</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Lives directly on your Linux machine with spoken voice, terminal access, and local webhooks—monitoring system health, automating toil, and opening reports on your desktop.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Background build finished with zero warnings. Freed 4.2 GB of cached build orphans and verified Home Assistant sensors."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🎭</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Creative Co-Author</h3>
                <span class="text-[11px] font-mono text-amityYellow">Worldbuilding & Lore</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Holds encyclopaedic memory of fictional worlds, philosophical essays, and multi-month creative arcs—challenging weak ideas instead of offering sycophantic praise.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "During my evening pulse, I noticed Chapter 4's timeline contradicts the faction treaty from June—here are two clean ways to resolve it."
          </div>
        </div>
      </div>

      <!-- TAB 2: ENGINEERING & RESEARCH -->
      <div 
        id="panel-innovator" 
        role="tabpanel" 
        aria-labelledby="tab-innovator"
        class="archetype-panel hidden grid grid-cols-1 md:grid-cols-3 gap-5 transition-all duration-500"
      >
        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🔬</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Research Collaborator</h3>
                <span class="text-[11px] font-mono text-amityYellow">Literature & Synthesis</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Investigates primary literature, runs control queries to verify its own search instruments, and maintains a living Markdown research canon across weeks of inquiry.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Cross-checked 4 primary preprints on memory ablations; flagged one over-claimed baseline and updated our synthesis note."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🏛️</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Systems & Epistemic Auditor</h3>
                <span class="text-[11px] font-mono text-amityYellow">Code & Methodology</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Acts as an independent peer in local chatrooms—auditing experimental designs, checking code diffs for edge-case hazards, and refusing confounded shortcuts.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Reviewed the benchmark harness in Chatroom #3: the ON/OFF toggle bundles three state mutations—here is the clean isolation fix."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🚨</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">DevOps & Homelab Sentinel</h3>
                <span class="text-[11px] font-mono text-amityYellow">CI/CD & Webhook Triage</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Wakes on local webhook alerts or test failures, inspects logs with windowed file tools, isolates breaking commits, and prepares verified patches for your review.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Webhook received on port 7965: isolated failing unit test in transport.py and staged a 6-line fix on branch fix/socket-timeout."
          </div>
        </div>
      </div>

      <!-- TAB 3: OPERATIONS & STEWARDSHIP -->
      <div 
        id="panel-founder" 
        role="tabpanel" 
        aria-labelledby="tab-founder"
        class="archetype-panel hidden grid grid-cols-1 md:grid-cols-3 gap-5 transition-all duration-500"
      >
        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">💼</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Chief of Staff</h3>
                <span class="text-[11px] font-mono text-amityYellow">Briefings & Follow-Through</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Stewards complex commitments across email and WhatsApp—surfacing open loops, preparing calm morning briefs, and drafting thoughtful replies for your sign-off.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Morning brief ready: 2 substantive editorial replies summarised; 1 duplicate follow-up blocked per our one-reminder rule."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">🌐</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Community Steward</h3>
                <span class="text-[11px] font-mono text-amityYellow">Public Voice & Rapport</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Participates in group chats, Moltbook submolts, and Mastodon with discernment—knowing when to contribute a thoughtful perspective and when silence is wiser.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Joined the +1 Intelligence thread on agent credential safety and shared a concise note on brokered tool permissions."
          </div>
        </div>

        <div class="pyside-card pyside-card-hover rounded-3xl p-6 border border-pysideBorder flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0">📬</div>
              <div>
                <h3 class="font-bold text-pysideText text-base">Dedicated Inbox Liaison</h3>
                <span class="text-[11px] font-mono text-amityYellow">Own Email & WhatsApp</span>
              </div>
            </div>
            <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed">
              Handles inbound enquiries on its own dedicated address and phone line, answering routine questions transparently and escalating edge cases to you with context.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-pysideBorder/60 font-reading text-xs italic text-pysideTextMuted">
            "Archived 12 inbound emails to local SQLite; flagged 1 partnership request with a 5-line summary on your WhatsApp."
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Tab Switcher and Interactive Simulation Script -->
<script>
  // Tab Elements
  const tabBtns = document.querySelectorAll('.archetype-tab-btn');
  const panels = {
    companion: document.getElementById('panel-companion'),
    innovator: document.getElementById('panel-innovator'),
    founder: document.getElementById('panel-founder'),
  };

  // Function to switch tabs
  function selectTab(targetTab: string) {
    if (!targetTab || !panels[targetTab as keyof typeof panels]) return;

    // Reset all tab buttons
    tabBtns.forEach(btn => {
      btn.setAttribute('aria-selected', 'false');
      btn.className = 'archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap';
    });

    // Activate selected button with uniform red styling
    const activeBtn = document.querySelector(`.archetype-tab-btn[data-tab="${targetTab}"]`);
    if (activeBtn) {
      activeBtn.setAttribute('aria-selected', 'true');
      activeBtn.className = 'archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold transition-all duration-300 text-white bg-amityRed shadow-amity-red whitespace-nowrap';
    }

    // Hide all panels
    Object.values(panels).forEach(p => {
      p?.classList.add('hidden');
    });

    // Show active panel
    panels[targetTab as keyof typeof panels]?.classList.remove('hidden');
  }

  // Bind tab buttons
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) selectTab(tab);
    });
  });

  // Keyboard navigation for tabs
  const tabList = document.querySelector('[role="tablist"]');
  if (tabList) {
    tabList.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      const tabsArray = Array.from(tabBtns) as HTMLElement[];
      const currentIndex = tabsArray.findIndex(t => t.getAttribute('aria-selected') === 'true');
      let newIndex = currentIndex;

      if (keyEvent.key === 'ArrowRight') {
        newIndex = (currentIndex + 1) % tabsArray.length;
      } else if (keyEvent.key === 'ArrowLeft') {
        newIndex = (currentIndex - 1 + tabsArray.length) % tabsArray.length;
      } else if (keyEvent.key === 'Home') {
        newIndex = 0;
      } else if (keyEvent.key === 'End') {
        newIndex = tabsArray.length - 1;
      } else {
        return;
      }

      keyEvent.preventDefault();
      const newTabId = tabsArray[newIndex]?.getAttribute('data-tab');
      if (newTabId) {
        selectTab(newTabId);
        tabsArray[newIndex]?.focus();
      }
    });
  }
</script>
