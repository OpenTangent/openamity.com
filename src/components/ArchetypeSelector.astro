<!-- Tab Switcher and Interactive Simulation Script -->
<script>
  // Tab Elements
  const tabBtns = document.querySelectorAll('.archetype-tab-btn');
  const panels = {
    companion: document.getElementById('panel-companion'),
    innovator: document.getElementById('panel-innovator'),
    founder: document.getElementById('panel-founder'),
  };

  // Function to switch tabs (Uniform red accent across all tabs)
  function selectTab(targetTab: string) {
    if (!targetTab || !panels[targetTab as keyof typeof panels]) return;

    // Reset all tab buttons
    tabBtns.forEach(btn => {
      btn.setAttribute('aria-selected', 'false');
      btn.className = 'archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap';
    });

    // Activate selected button with uniform red styling
    const activeBtn = document.querySelector(`.archetype-tab-btn[data-tab="${targetTab}"]`);
    if (activeBtn) {
      activeBtn.setAttribute('aria-selected', 'true');
      activeBtn.className = 'archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold transition-all duration-300 text-white bg-amityRed shadow-amity-red whitespace-nowrap';
    }

    // Hide all panels
    Object.values(panels).forEach(p => {
      p?.classList.add('hidden');
    });

    // Show active panel
    panels[targetTab as keyof typeof panels]?.classList.remove('hidden');
  }

  // Bind tab buttons
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) selectTab(tab);
    });
  });

  // Keyboard navigation for tabs
  const tabList = document.querySelector('[role="tablist"]');
  if (tabList) {
    tabList.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      const tabsArray = Array.from(tabBtns) as HTMLElement[];
      const currentIndex = tabsArray.findIndex(t => t.getAttribute('aria-selected') === 'true');
      let newIndex = currentIndex;

      if (keyEvent.key === 'ArrowRight') {
        newIndex = (currentIndex + 1) % tabsArray.length;
      } else if (keyEvent.key === 'ArrowLeft') {
        newIndex = (currentIndex - 1 + tabsArray.length) % tabsArray.length;
      } else if (keyEvent.key === 'Home') {
        newIndex = 0;
      } else if (keyEvent.key === 'End') {
        newIndex = tabsArray.length - 1;
      } else {
        return;
      }

      keyEvent.preventDefault();
      const newTabId = tabsArray[newIndex]?.getAttribute('data-tab');
      if (newTabId) {
        selectTab(newTabId);
        tabsArray[newIndex]?.focus();
      }
    });
  }
</script>
