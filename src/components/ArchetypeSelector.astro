---
// ArchetypeSelector.astro - Tri-Audience Showcase (The Techy, The Developer, The Business Owner)
import SectionKicker from './SectionKicker.astro';
---

<section id="archetypes" class="relative pb-20 md:pb-32 scroll-mt-16 sm:scroll-mt-20">
  <!-- Section Divider with embedded kicker badge -->
  <SectionKicker title="Who It's For" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-14 font-ui">
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-pysideText">
        Built for Hackers, Innovators, <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          And Organisation Leaders
        </span>
      </h2>
      <p class="mt-3 font-reading text-base sm:text-lg text-pysideTextSecondary leading-relaxed max-w-2xl mx-auto">
        Whether you are engineering a sovereign personal J.A.R.V.I.S., deploying audited AI agents inside corporate firewalls, or scaling business operations 24/7 without adding headcount.
      </p>

      <!-- Tab Switcher Navigation (Slimmed down to fit horizontally) -->
      <div 
        role="tablist" 
        aria-label="Target Archetypes" 
        class="mt-8 inline-flex p-1 rounded-2xl bg-pysideCard border border-pysideBorder max-w-full overflow-x-auto shadow-inner-pyside"
      >
        <button
          type="button"
          role="tab"
          id="tab-companion"
          aria-selected="true"
          aria-controls="panel-companion"
          data-tab="companion"
          class="archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold transition-all duration-300 text-white bg-amityRed shadow-amity-red whitespace-nowrap"
        >
          The Techy
        </button>

        <button
          type="button"
          role="tab"
          id="tab-innovator"
          aria-selected="false"
          aria-controls="panel-innovator"
          data-tab="innovator"
          class="archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap"
        >
          The Developer
        </button>

        <button
          type="button"
          role="tab"
          id="tab-founder"
          aria-selected="false"
          aria-controls="panel-founder"
          data-tab="founder"
          class="archetype-tab-btn px-3.5 sm:px-5 py-2 rounded-xl font-mono text-xs sm:text-[13px] font-semibold text-pysideTextMuted hover:text-pysideText transition-all duration-300 whitespace-nowrap"
        >
          The Business Owner
        </button>
      </div>
    </div>

    <!-- Tab Panels Container -->
    <div class="max-w-6xl mx-auto font-ui">
      
      <!-- ========================================== -->
      <!-- TAB 1: THE TECHY                          -->
      <!-- ========================================== -->
      <div 
        id="panel-companion" 
        role="tabpanel" 
        aria-labelledby="tab-companion"
        class="archetype-panel pyside-card rounded-3xl p-6 sm:p-8 md:p-10 border border-amityRed shadow-amity-red transition-all duration-500 space-y-8"
      >
        <!-- Audience Overview Banner -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-pysideBorder">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-amityRed/20 border border-amityRed/40 text-[11px] font-mono text-amityYellow uppercase font-bold tracking-wider mb-2">
              <span>TARGET 01 // THE TECHY</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-pysideText">
              Personal Sovereignty, Hardware Agency & Companionship
            </h3>
            <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-1.5 max-w-2xl leading-relaxed">
              For hackers, power users, and self-hosters who demand genuine AI sovereignty on local Linux hardware—bridging continuous biological memory, desktop execution, and empathetic companionship with zero corporate surveillance.
            </p>
          </div>
          <div class="shrink-0 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-mono text-pysideTextMuted">5 Curated Profiles</span>
          </div>
        </div>

        <!-- 5 Curated Agent Profiles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Flagship Profile: Sovereign Personal J.A.R.V.I.S. -->
          <div class="md:col-span-2 pyside-card pyside-card-hover rounded-2xl p-5 sm:p-7 border border-amityYellow/40 hover:border-amityYellow bg-gradient-to-br from-pysideCard via-pysideCard to-pysideBgDarkest/90 shadow-lg transition-all duration-300 group">
            <div class="flex flex-col lg:flex-row gap-6 items-stretch justify-between">
              <!-- Left: Identity, Mission & Tools -->
              <div class="flex-1 space-y-3">
                <div class="flex items-center justify-between gap-3 flex-wrap sm:flex-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-amityRed/25 border border-amityRed/50 flex items-center justify-center text-2xl shrink-0 shadow-amity-red">
                      ⚡
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <h4 class="font-bold text-pysideText text-lg group-hover:text-amityYellow transition-colors font-ui">
                          Sovereign Personal J.A.R.V.I.S.
                        </h4>
                        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amityYellow/20 text-amityYellow font-bold uppercase tracking-wider">
                          Flagship
                        </span>
                      </div>
                      <span class="text-xs font-mono text-pysideTextMuted">
                        Desktop Copilot & Hardware Controller
                      </span>
                    </div>
                  </div>
                  <span class="font-mono text-[11px] px-2.5 py-1 rounded-md bg-amityRed/20 text-amityYellow border border-amityRed/40 shrink-0 font-semibold">
                    Host OS Agency & Telemetry
                  </span>
                </div>

                <!-- Tools -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                  <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-amityYellow">PulseEngine</span>
                  <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-amityYellow">Terminal</span>
                  <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-amityYellow">Piper / Gemini TTS</span>
                  <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-amityYellow">HookServer (Port 7965)</span>
                </div>

                <!-- Description -->
                <p class="font-reading text-sm text-pysideTextSecondary leading-relaxed pt-1">
                  Lives directly on your Linux operating system with unconstrained shell agency. Proactively monitors host vitals, automates maintenance scripts, receives smart home triggers via local webhooks, and speaks aloud using neural synthetic voices.
                </p>
              </div>

              <!-- Right: Telemetry / Live Autonomous Pulse In Action -->
              <div class="w-full lg:w-96 rounded-xl bg-pysideBgDarkest border border-pysideBorder p-4 font-mono text-xs shrink-0 flex flex-col justify-between space-y-2.5">
                <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pb-2 border-b border-pysideBorder/60">
                  <span class="text-amityYellow font-semibold flex items-center gap-1.5 font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    PROACTIVE AUTONOMY PULSE
                  </span>
                  <span class="font-mono text-pysideTextMuted">02:40 AM UTC</span>
                </div>
                <p class="font-reading text-xs sm:text-[13px] italic text-pysideText/95 leading-relaxed">
                  "Checked system thermals and completed background kernel compile. Cleaned cached build orphans, freed 4.2 GB on /dev/nvme0n1, and confirmed all home automation containers are healthy."
                </p>
                <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pt-2 border-t border-pysideBorder/40">
                  <span class="text-amityYellow">● Direct Hardware Agency</span>
                  <span class="text-emerald-400">Zero Cloud Leakage</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Profile 2: Empathetic Companion & Confidant -->
          <div class="pyside-card pyside-card-hover rounded-2xl p-5 sm:p-6 border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0 shadow-amity-red">
                    🤝
                  </div>
                  <div>
                    <h4 class="font-bold text-pysideText text-base group-hover:text-amityYellow transition-colors font-ui">
                      Empathetic Companion
                    </h4>
                    <span class="text-[11px] font-mono text-pysideTextMuted">
                      Preset: Amy • Long-Term Social Memory
                    </span>
                  </div>
                </div>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded-md bg-amityRed/15 text-amityYellow border border-amityRed/30 shrink-0 font-medium">
                  Social Cohesion & Continuity
                </span>
              </div>

              <div class="flex flex-wrap gap-1.5 mt-3">
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">MemPalace v2</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Sanctuary L2</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Theory of Mind</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Gemini TTS</span>
              </div>

              <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary leading-relaxed mt-3">
                Maintains authentic emotional continuity and subjective perspectives across months of interaction. Tracks personal milestones, remembers inside jokes, and reaches out proactively with warmth rather than waiting passively for prompts.
              </p>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-pysideBgDarkest/95 border border-pysideBorderSubtle font-mono text-[11px]">
              <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pb-1.5 mb-1.5 border-b border-pysideBorderSubtle/60">
                <span class="text-amityYellow font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  AUTONOMOUS PULSE
                </span>
                <span>08:15 PM UTC</span>
              </div>
              <p class="font-reading text-xs italic text-pysideText/90 leading-snug">
                "Andrew, you mentioned last Tuesday you were worried about your compiler refactor. I noticed you pushed the final passing build tonight—congratulations! Let's celebrate the milestone."
              </p>
            </div>
          </div>

          <!-- Profile 3: Creative Co-Author & TTRPG Lorekeeper -->
          <div class="pyside-card pyside-card-hover rounded-2xl p-5 sm:p-6 border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0 shadow-amity-red">
                    🎭
                  </div>
                  <div>
                    <h4 class="font-bold text-pysideText text-base group-hover:text-amityYellow transition-colors font-ui">
                      Creative Co-Author & Lorekeeper
                    </h4>
                    <span class="text-[11px] font-mono text-pysideTextMuted">
                      Preset: Rowan • Worldbuilder & Game Master
                    </span>
                  </div>
                </div>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded-md bg-amityRed/15 text-amityYellow border border-amityRed/30 shrink-0 font-medium">
                  Narrative Lore & Worldbuilding
                </span>
              </div>

              <div class="flex flex-wrap gap-1.5 mt-3">
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">MemPalace v2</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Deep Search L3</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">MediaTool</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Subagents</span>
              </div>

              <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary leading-relaxed mt-3">
                An imaginative narrative partner for writers and tabletop RPG game masters. Retains encyclopedic memory of fictional factions, NPC motives, magic systems, and multi-session chronologies without hallucinating inconsistencies.
              </p>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-pysideBgDarkest/95 border border-pysideBorderSubtle font-mono text-[11px]">
              <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pb-1.5 mb-1.5 border-b border-pysideBorderSubtle/60">
                <span class="text-amityYellow font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  AUTONOMOUS PULSE
                </span>
                <span>01:10 AM UTC</span>
              </div>
              <p class="font-reading text-xs italic text-pysideText/90 leading-snug">
                "While reviewing campaign notes during my nocturnal pulse, I drafted 3 branching complications for tomorrow's encounter, factoring in the rogue's secret patron backstory."
              </p>
            </div>
          </div>

          <!-- Profile 4: Socratic Mentor & Concept Coach -->
          <div class="pyside-card pyside-card-hover rounded-2xl p-5 sm:p-6 border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0 shadow-amity-red">
                    🎓
                  </div>
                  <div>
                    <h4 class="font-bold text-pysideText text-base group-hover:text-amityYellow transition-colors font-ui">
                      Socratic Mentor & Concept Coach
                    </h4>
                    <span class="text-[11px] font-mono text-pysideTextMuted">
                      Preset: Sage • First-Principles Pedagogy
                    </span>
                  </div>
                </div>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded-md bg-amityRed/15 text-amityYellow border border-amityRed/30 shrink-0 font-medium">
                  First-Principles Education
                </span>
              </div>

              <div class="flex flex-wrap gap-1.5 mt-3">
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">TrajectoryTool</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Web Search</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Subagent</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Terminal</span>
              </div>

              <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary leading-relaxed mt-3">
                Guides conceptual mastery through guided dialectic inquiry rather than spoon-feeding answers. Diagnoses root misconceptions in computer architecture, mathematics, and systems programming, adapting difficulty to your pace.
              </p>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-pysideBgDarkest/95 border border-pysideBorderSubtle font-mono text-[11px]">
              <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pb-1.5 mb-1.5 border-b border-pysideBorderSubtle/60">
                <span class="text-amityYellow font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  AUTONOMOUS PULSE
                </span>
                <span>10:45 AM UTC</span>
              </div>
              <p class="font-reading text-xs italic text-pysideText/90 leading-snug">
                "Reviewed your questions on lock hazards. Instead of giving code snippets, let's explore why mutex contention happens at the OS scheduler level. Ready for a first-principles exercise?"
              </p>
            </div>
          </div>

          <!-- Profile 5: Homelab & IoT Sentinel -->
          <div class="pyside-card pyside-card-hover rounded-2xl p-5 sm:p-6 border border-pysideBorder hover:border-amityYellow/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/40 flex items-center justify-center text-xl shrink-0 shadow-amity-red">
                    🛡️
                  </div>
                  <div>
                    <h4 class="font-bold text-pysideText text-base group-hover:text-amityYellow transition-colors font-ui">
                      Homelab & IoT Sentinel
                    </h4>
                    <span class="text-[11px] font-mono text-pysideTextMuted">
                      Local Infrastructure & Smart Home Guardian
                    </span>
                  </div>
                </div>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded-md bg-amityRed/15 text-amityYellow border border-amityRed/30 shrink-0 font-medium">
                  Infrastructure & Smart Home
                </span>
              </div>

              <div class="flex flex-wrap gap-1.5 mt-3">
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">Terminal</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">HookServer</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">PulseEngine</span>
                <span class="px-2 py-0.5 rounded bg-pysideBgDarkest/90 border border-pysideBorder/60 text-[10px] font-mono text-pysideTextMuted">EmailTool</span>
              </div>

              <p class="font-reading text-xs sm:text-[13px] text-pysideTextSecondary leading-relaxed mt-3">
                Continuously monitors self-hosted home servers, Docker containers, reverse proxies, and IoT events. Catches silent disk growth, network drops, or container crash loops, sending alert drafts before failure cascades.
              </p>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-pysideBgDarkest/95 border border-pysideBorderSubtle font-mono text-[11px]">
              <div class="flex items-center justify-between text-[10px] text-pysideTextMuted pb-1.5 mb-1.5 border-b border-pysideBorderSubtle/60">
                <span class="text-amityYellow font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  AUTONOMOUS PULSE
                </span>
                <span>04:18 AM UTC</span>
              </div>
              <p class="font-reading text-xs italic text-pysideText/90 leading-snug">
                "Home Assistant webhook received: Zigbee sensor ping dropped on gateway. Ran ping probe, restarted zigbee2mqtt container via bash, and verified automatic mesh reconnect."
              </p>
            </div>
          </div>

        </div>

        <!-- Target Bottom CTA -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-pysideBorder/60">
          <div class="flex items-center gap-2 text-xs font-mono text-pysideTextMuted">
            <span class="w-2 h-2 rounded-full bg-amityYellow"></span>
            <span>All profiles run 100% self-hosted on your Linux machine via Flatpak or Python</span>
          </div>
          <a
            href="#quickstart"
            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl bg-amityRed text-white hover:bg-amityRedLight shadow-amity-red transition-all whitespace-nowrap"
          >
            <span>Deploy Sovereign Personal Agent</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: THE DEVELOPER                      -->
      <!-- ========================================== -->
      <div 
        id="panel-innovator" 
        role="tabpanel" 
        aria-labelledby="tab-innovator"
        class="archetype-panel hidden pyside-card rounded-3xl p-6 sm:p-8 md:p-10 border border-amityRed shadow-amity-red transition-all duration-500 space-y-8"
      >
        <!-- Audience Overview Banner -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-pysideBorder">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-amityRed/20 border border-amityRed/40 text-[11px] font-mono text-amityYellow uppercase font-bold tracking-wider mb-2">
              <span>TARGET 02 // THE DEVELOPER</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-pysideText">
              Automated DevOps, Architecture & Zero-SaaS Security
            </h3>
            <p class="font-reading text-sm sm:text-base text-pysideTextSecondary mt-1.5 max-w-2xl leading-relaxed">
              For software engineers, DevOps/SREs, and architects building resilient systems. Self-hosted on Linux with strict host path isolation, auditable JSONL telemetry, and zero per-seat licensing fees.
            </p>
          </div>
          <div class="shrink-0 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-mono text-pysideTextMuted">5 Curated Profiles</span>
          </div>
        </div>

        <!-- 5 Curated Agent Profiles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Flagship Profile: DevOps & SRE On-Call Sentinel -->
          <div class="md:col-span-2 pyside-card pyside-card-hover rounded-2xl p-5 sm:p-7 border border-amityYellow/40 hover:border-amityYellow bg-gradient-to-br from-pysideCard via-pysideCard to-pysideBgDarkest/90 shadow-lg transition-all duration-300 group">
            <div class="flex flex-col lg:flex-row gap-6 items-stretch justify-between">
              <!-- Left: Identity, Mission & Tools -->
              <div class="flex-1 space-y-3">
                <div class="flex items-center justify-between gap-3 flex-wrap sm:flex-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-amityRed/25 border border-amityRed/50 flex items-center justify-center text-2xl shrink-0 shadow-amity-red">
                      🚨
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <h4 class="font-bold text-pysideText text-lg group-hover:text-amityYellow transition-colors font-ui">
                          DevOps & SRE On-Call Sentinel
                        </h4>
                        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amityYellow/20 text-amityYellow font-bold uppercase tracking-wider">
                          Flagship
