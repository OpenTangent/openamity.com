---
// TheDivide.astro - The Paradigm Split: Disposable Cloud Bot vs Sovereign Agent
---

<section id="divide" class="py-20 md:py-32 relative border-t border-pysideBorder">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 font-ui">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amityRed/20 border border-amityRed/50 text-amityYellow text-xs font-mono mb-4">
        <span>⚡ THE PARADIGM SHIFT</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-pysideText">
        Disposable Cloud Bot vs. <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amityRed via-amityRedLight to-amityYellow">
          Sovereign Agent
        </span>
      </h2>
      <p class="mt-4 font-reading text-xl sm:text-2xl text-pysideTextSecondary leading-relaxed">
        Why does conversational AI feel disposable? Because current platforms are stateless SaaS products engineered for subscription capture, not autonomous collaboration.
      </p>

      <!-- Interactive "Simulate Closing Browser" Control -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button
          id="simulate-close-btn"
          type="button"
          class="relative inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-pysideButton hover:bg-pysideButtonHover border border-amityRed/60 hover:border-amityRed text-pysideText font-mono text-sm transition-all duration-300 shadow-lg hover:shadow-amity-red active:scale-95 group"
        >
          <span class="w-3 h-3 rounded-full bg-amityRed group-hover:scale-125 transition-transform"></span>
          <span id="close-btn-text">✕ Simulate Closing Browser Tab</span>
        </button>
        <span class="text-xs font-mono text-pysideTextMuted">
          Toggle to witness what happens to your AI's mind when you walk away.
        </span>
      </div>
    </div>

    <!-- Side-by-Side Comparison Matrix in PySide6 greys -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch font-ui">
      
      <!-- Left Column: The Cloud Chatbot You Rent -->
      <div
        id="cloud-chatbot-panel"
        class="pyside-card rounded-2xl p-6 sm:p-8 relative flex flex-col justify-between transition-all duration-700 overflow-hidden"
      >
        <!-- Overlay for Browser Termination State -->
        <div
          id="cloud-terminated-overlay"
          class="absolute inset-0 bg-pysideBgDarkest/95 backdrop-blur-sm hidden flex-col items-center justify-center p-6 text-center z-20 transition-opacity duration-500"
        >
          <div class="w-16 h-16 rounded-full bg-amityRed/20 border border-amityRed flex items-center justify-center text-amityRedLight text-2xl font-mono mb-4 animate-pulse">
            0_0
          </div>
          <h4 class="text-lg font-mono font-bold text-amityRedLight tracking-wide font-ui">
            [CONNECTION TERMINATED]
          </h4>
          <p class="font-reading text-base text-pysideTextMuted max-w-sm mt-2">
            Tab closed. Context destroyed. The model has forgotten your name, your code, and your project until you re-prompt it.
          </p>
          <div class="mt-4 px-3 py-1 rounded bg-[#2e1514] border border-amityRedDark text-[11px] font-mono text-amityYellow">
            Memory Conductance: 0.00 | Agent Status: DEAD
          </div>
        </div>

        <div>
          <!-- Header -->
          <div class="flex items-center justify-between pb-6 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-pysideInput flex items-center justify-center text-pysideTextMuted font-mono">
                ☁️
              </div>
              <div>
                <h3 class="font-bold text-lg text-pysideText">The Cloud Chatbot You Rent</h3>
                <span class="text-xs font-mono text-amityRedLight">Stateless SaaS Utility</span>
              </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-pysideInput border border-pysideBorder text-pysideTextMuted">
              Disposable
            </span>
          </div>

          <!-- Feature Breakdown Rows -->
          <div class="space-y-6 mt-6">
            <!-- Row 1: Closing Tab -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-pysideTextMuted">When Tab Closes</span>
              <p class="font-reading text-lg text-pysideTextSecondary flex items-start gap-2">
                <span class="text-amityRed mt-1 font-bold font-mono">✕</span>
                Context wiped completely. Vanishes until manually summoned.
              </p>
            </div>

            <!-- Row 2: Memory -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-pysideTextMuted">Memory Architecture</span>
              <p class="font-reading text-lg text-pysideTextSecondary flex items-start gap-2">
                <span class="text-amityRed mt-1 font-bold font-mono">✕</span>
                Flat logbook buffer that overflows, fragments, and hallucinates.
              </p>
            </div>

            <!-- Row 3: Personality & Soul -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-pysideTextMuted">Self-Perception & Values</span>
              <p class="font-reading text-lg text-pysideTextSecondary flex items-start gap-2">
                <span class="text-amityRed mt-1 font-bold font-mono">✕</span>
                Sterile, apologetic customer service script with zero true subjective core.
              </p>
            </div>

            <!-- Row 4: Presence -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-pysideTextMuted">Physical Presence</span>
              <p class="font-reading text-lg text-pysideTextSecondary flex items-start gap-2">
                <span class="text-amityRed mt-1 font-bold font-mono">✕</span>
                Trapped inside a single web browser window. Completely deaf to real-world triggers.
              </p>
            </div>

            <!-- Row 5: Sovereignty -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-pysideTextMuted">Cost & Sovereignty</span>
              <p class="font-reading text-lg text-pysideTextSecondary flex items-start gap-2">
                <span class="text-amityRed mt-1 font-bold font-mono">✕</span>
                Proprietary walled garden. \$20–\$200/seat/month. Data harvested for retraining.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-pysideBorder flex items-center justify-between text-xs font-mono text-pysideTextMuted">
          <span>Inert until prompted</span>
          <span>Zero local persistence</span>
        </div>
      </div>

      <!-- Right Column: Open Amity Sovereign Agent -->
      <div
        id="amity-agent-panel"
        class="pyside-card rounded-2xl p-6 sm:p-8 border-amityRed relative flex flex-col justify-between shadow-amity-red transition-all duration-700"
      >
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between pb-6 border-b border-pysideBorder">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amityRed/20 border border-amityRed/50 flex items-center justify-center">
                <img src="/images/com.openamity.OpenAmity.png" alt="Open Amity" class="w-7 h-7 object-contain" />
              </div>
              <div>
                <h3 class="font-bold text-lg text-pysideText flex items-center gap-2">
                  Open Amity Sovereign Agent
                </h3>
                <span class="text-xs font-mono text-amityYellow">Proactive Autonomous Entity</span>
              </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-amityRed/20 border border-amityRed/60 text-amityYellow font-bold">
              Autonomous
            </span>
          </div>

          <!-- Feature Breakdown Rows -->
          <div class="space-y-6 mt-6">
            <!-- Row 1: When Tab Closes -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-amityYellow">When Tab Closes</span>
              <p class="font-reading text-lg text-pysideText flex items-start gap-2">
                <span class="text-amityYellow mt-1 font-bold font-mono">✓</span>
                <span id="daemon-state-text">
                  <strong>Keeps working.</strong> Dispatches emails, sweeps research safaris, and consolidates memory palace.
                </span>
              </p>
            </div>

            <!-- Row 2: Memory -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-amityYellow">Memory Architecture</span>
              <p class="font-reading text-lg text-pysideText flex items-start gap-2">
                <span class="text-amityYellow mt-1 font-bold font-mono">✓</span>
                <span>
                  <strong>Biological Morphological Memory.</strong> Associative graph dynamics, Hebbian conductance, and zero-cost structural bias.
                </span>
              </p>
            </div>

            <!-- Row 3: Personality -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-amityYellow">Self-Perception & Values</span>
              <p class="font-reading text-lg text-pysideText flex items-start gap-2">
                <span class="text-amityYellow mt-1 font-bold font-mono">✓</span>
                <span>
                  <strong>Dynamic Self-Awareness.</strong> Theory of Mind mirrors, genuine values, evolving aspirations, and radical honesty.
                </span>
              </p>
            </div>

            <!-- Row 4: Presence -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-amityYellow">Physical Presence</span>
              <p class="font-reading text-lg text-pysideText flex items-start gap-2">
                <span class="text-amityYellow mt-1 font-bold font-mono">✓</span>
                <span>
                  <strong>Omnipresent.</strong> Native desktop voice & console, WhatsApp voice notes, autonomous email, and stealth Camoufox browser.
                </span>
              </p>
            </div>

            <!-- Row 5: Sovereignty -->
            <div class="flex flex-col space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-amityYellow">Cost & Sovereignty</span>
              <p class="font-reading text-lg text-pysideText flex items-start gap-2">
                <span class="text-amityYellow mt-1 font-bold font-mono">✓</span>
                <span>
                  <strong>100% Sovereign & Free.</strong> GPLv3 on your machine. Compatible with local Ollama/vLLM & frontier APIs.
                </span>
              </p>
            </div>
          </div>
        </div>

        <!-- Live Daemon Telemetry Footnote -->
        <div class="mt-8 pt-4 border-t border-pysideBorder flex items-center justify-between text-xs font-mono">
          <div class="flex items-center gap-2 text-amityYellow">
            <span class="w-2 h-2 rounded-full bg-amityRed animate-ping"></span>
            <span id="daemon-pulse-label">PulseEngine: Loop active (Heartbeat: 4s)</span>
          </div>
          <span class="text-pysideTextMuted font-bold">State: .oaa snapshot safe</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client Script for Simulate Closing Browser Toggle -->
<script>
  let isTabClosed = false;
  const toggleBtn = document.getElementById('simulate-close-btn');
  const btnText = document.getElementById('close-btn-text');
  const cloudOverlay = document.getElementById('cloud-terminated-overlay');
  const cloudPanel = document.getElementById('cloud-chatbot-panel');
  const amityPanel = document.getElementById('amity-agent-panel');
  const daemonText = document.getElementById('daemon-state-text');
  const daemonPulseLabel = document.getElementById('daemon-pulse-label');

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isTabClosed = !isTabClosed;

      if (isTabClosed) {
        cloudOverlay?.classList.remove('hidden');
        cloudOverlay?.classList.add('flex');
        cloudPanel?.classList.add('opacity-40', 'grayscale');

        amityPanel?.classList.add('shadow-amity-red-lg', 'border-amityRedLight');
        if (daemonText) {
          daemonText.innerHTML = '<span class="text-amityYellow font-bold">⚡ Tab closed! Autonomous daemon active:</span> Triggering background research safari, consolidating Sanctuary memory nodes, and awaiting next pulse.';
        }
        if (daemonPulseLabel) {
          daemonPulseLabel.innerHTML = 'Autonomous background daemon running without browser UI';
        }
        if (btnText) {
          btnText.textContent = '↺ Reopen Browser Tab (Restore Context)';
        }
      } else {
        cloudOverlay?.classList.add('hidden');
        cloudOverlay?.classList.remove('flex');
        cloudPanel?.classList.remove('opacity-40', 'grayscale');

        amityPanel?.classList.remove('shadow-amity-red-lg');
        if (daemonText) {
          daemonText.innerHTML = '<strong>Keeps working.</strong> Dispatches emails, sweeps research safaris, and consolidates memory palace.';
        }
        if (daemonPulseLabel) {
          daemonPulseLabel.innerHTML = 'PulseEngine: Loop active (Heartbeat: 4s)';
        }
        if (btnText) {
          btnText.textContent = '✕ Simulate Closing Browser Tab';
        }
      }
    });
  }
</script>
