---
// SectionKicker.astro - Minimalist Architectural Section Divider
interface Props {
  title: string;
  index?: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<div
  class={`relative w-full max-w-5xl mx-auto px-4 py-4 flex items-center justify-center select-none font-ui ${className}`}
  aria-label={`Section: ${title}`}
>
  <div class="w-full h-px bg-gradient-to-r from-transparent via-pysideBorder to-transparent"></div>
  <div class="absolute inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pysideBg border border-pysideBorder text-[11px] font-mono uppercase tracking-[0.18em] text-amityYellow shadow-sm">
    <span class="w-1.5 h-1.5 rounded-full bg-amityRed"></span>
    <span>{title}</span>
  </div>
</div>
